def _run_in_omniverse():
    import omni.usd
    import omni.kit.app
    import omni.timeline
    from pxr import Usd, UsdGeom, UsdPhysics, Sdf, Gf, Vt

    old = getattr(builtins, "_oht_fleet", None)
    if old is not None:
        old.stop()

    class _W:
        """Fast attribute writer: skips unchanged values and writes straight to
        the layer (Sdf) instead of through Usd, which is much cheaper per frame."""
        __slots__ = ("attr", "spec", "cls", "last")

        def __init__(self, attr):
            self.attr, self.spec, self.last = attr, None, None
            self.cls = attr.GetTypeName().type.pythonClass

        def set(self, value):
            if self.cls is not None and not isinstance(value, self.cls):
                value = self.cls(value)
            if value == self.last:
                return
            self.last = value
            if self.spec is None:
                self.attr.Set(value)            # first write creates the spec
                layer = stage.GetEditTarget().GetLayer()
                self.spec = layer.GetAttributeAtPath(self.attr.GetPath()) or False
            elif self.spec:
                self.spec.default = value
            else:
                self.attr.Set(value)

    stage = omni.usd.get_context().get_stage()
    if UsdGeom.GetStageUpAxis(stage) != UsdGeom.Tokens.z:
        print("[OHT Fleet] WARNING: this stage is Y-up; the script assumes Z-up")
    if abs(UsdGeom.GetStageMetersPerUnit(stage) - 1.0) > 1e-6:
        print("[OHT Fleet] WARNING: stage units are %.3g m, the script assumes metres"
              % UsdGeom.GetStageMetersPerUnit(stage))
    dst_layer = stage.GetEditTarget().GetLayer()

    # ---- small helpers ---------------------------------------------------
    def _qyaw(q):
        return 2 * math.atan2(q.GetImaginary()[2], q.GetReal())

    def _bbox(prim):
        try:
            c_ = UsdGeom.BBoxCache(Usd.TimeCode.Default(), [UsdGeom.Tokens.default_, UsdGeom.Tokens.render])
            r = c_.ComputeWorldBound(prim).ComputeAlignedRange()
            return None if r.IsEmpty() else r
        except Exception:
            return None

    def _wmat(prim):
        return UsdGeom.Xformable(prim).ComputeLocalToWorldTransform(Usd.TimeCode.Default())

    def _world(prim):
        """(x, y, z, yaw) of a prim in world space, from its full transform"""
        m = Gf.Matrix4d(1.0)             # walk up the hierarchy (also works if a model
        p = prim                         # didn't load and its prim has no type)
        while p and p.GetPath() != Sdf.Path.absoluteRootPath:
            m = m * UsdGeom.Xformable(p).GetLocalTransformation(Usd.TimeCode.Default())
            p = p.GetParent()
        t = m.ExtractTranslation()
        return t[0], t[1], t[2], math.atan2(m[0][1], m[0][0])

    def _yaw_of(prim):
        return _world(prim)[3]

    def _T(v):
        return Gf.Matrix4d(1.0).SetTranslate(Gf.Vec3d(*v))

    def _Rz(rad):
        return Gf.Matrix4d(1.0).SetRotate(Gf.Rotation(Gf.Vec3d(0, 0, 1), math.degrees(rad)))

    def _qz(rad):
        return Gf.Quatd(math.cos(rad / 2), 0, 0, math.sin(rad / 2))

    def _attr(prim, name, vtype):
        a = prim.GetAttribute(name)
        return a if a else prim.CreateAttribute(name, vtype)

    def _setv(attr, value):
        cls = attr.GetTypeName().type.pythonClass
        attr.Set(cls(value) if cls is not None else value)

    def _clone(src_path, dst_path):
        """copy a prim (its layer spec, or an internal reference if it has none)"""
        layer = next((l for l in stage.GetLayerStack() if l.GetPrimAtPath(src_path)), None)
        if layer is not None:
            Sdf.CopySpec(layer, src_path, dst_layer, dst_path)
            prim = stage.GetPrimAtPath(dst_path)
        else:
            src = stage.GetPrimAtPath(src_path)
            prim = stage.DefinePrim(dst_path, src.GetTypeName())
            prim.GetReferences().AddInternalReference(src_path)
        return prim

    # ---- template OHT -----------------------------------------------------
    tmpl = stage.GetPrimAtPath(TEMPLATE_PATH)
    template_path = TEMPLATE_PATH
    if not tmpl.IsValid():
        tmpl = stage.GetPrimAtPath(OLD_TEMPLATE_PATH)
        template_path = OLD_TEMPLATE_PATH
        print("[OHT Fleet] %s not found — using %s" % (TEMPLATE_PATH, OLD_TEMPLATE_PATH))
    if not tmpl.IsValid():
        raise RuntimeError("Template prim not found: " + TEMPLATE_PATH)

    t_attr = tmpl.GetAttribute("xformOp:translate:oht")
    o_attr0 = tmpl.GetAttribute("xformOp:orient:oht")
    # "prepared" = the model already has the :oht ops this script drives (your
    # current OHT2grip_Revised). A fresh model in a new file is prepared here.
    prepared = bool(t_attr) and t_attr.Get() is not None and bool(o_attr0) and o_attr0.Get() is not None
    Mw_t = _wmat(tmpl)
    tt = Mw_t.ExtractTranslation()
    yaw_t = math.atan2(Mw_t[0][1], Mw_t[0][0])
    if prepared:
        oht_z = float(t_attr.Get()[2])
        base = tmpl.GetCustomDataByKey("ohtFollowerBaseOrient")
        base_q = Gf.Quatd(base[0], base[1], base[2], base[3]) if base is not None else Gf.Quatd(1, 0, 0, 0)
    else:
        oht_z = float(tt[2])
        base_q = Gf.Quatd(1, 0, 0, 0)
        print("[OHT Fleet] %s is a new model: it is driven from where you placed it" % template_path)
    oht_z += OHT_Z_OFFSET_M
    base_yaw = _qyaw(base_q)
    yaw_off = math.radians(YAW_OFFSET_DEG)

    drop_m = HOIST_DROP_M if HOIST_DROP_M is not None else 2.5    # fallback only

    # ---- fleet prims
    fleet = UsdGeom.Xform.Define(stage, FLEET_PATH).GetPrim()
    for child in list(fleet.GetChildren()):
        stage.RemovePrim(child.GetPath())

    base0 = Mw_t * _T(-tt) * _Rz(-yaw_t)          # model without its position and heading
    prims = []
    for i in range(NUM_OHT):
        p = "%s/OHT_%02d" % (FLEET_PATH, i + 1)
        prim = _clone(template_path, p)
        prim.ClearCustomDataByKey("ohtFollowerMagazine")
        UsdGeom.Imageable(prim).MakeVisible()
        if not prepared:
            ta = _attr(prim, "xformOp:translate:oht", Sdf.ValueTypeNames.Double3)
            oa = _attr(prim, "xformOp:orient:oht", Sdf.ValueTypeNames.Quatd)
            ba = _attr(prim, "xformOp:transform:ohtBase", Sdf.ValueTypeNames.Matrix4d)
            _setv(ta, Gf.Vec3d(tt[0], tt[1], oht_z))
            _setv(oa, _qz(yaw_t))
            ba.Set(base0)
            UsdGeom.Xformable(prim).GetXformOpOrderAttr().Set(Vt.TokenArray(
                ["xformOp:translate:oht", "xformOp:orient:oht", "xformOp:transform:ohtBase"]))
        hoist = stage.GetPrimAtPath(p + "/Hoist_Unit")
        hoist_attr = hoist.GetAttribute("xformOp:translate:hoistDrop") if hoist.IsValid() else None
        claws = []
        for name in ("Claw_Front", "Claw_Back"):
            cp = stage.GetPrimAtPath(p + "/Hoist_Unit/" + name)
            if cp.IsValid() and cp.GetAttribute("xformOp:translate").Get() is not None:
                a = cp.GetAttribute("xformOp:translate")
                claws.append((_W(a), Gf.Vec3d(a.Get())))
        prims.append((prim.GetAttribute("xformOp:translate:oht"),
                      prim.GetAttribute("xformOp:orient:oht"),
                      hoist_attr, prim, claws))
    if HIDE_TEMPLATE:
        UsdGeom.Imageable(tmpl).MakeInvisible()

    box0 = _bbox(prims[0][3])                    # OHT_01 still stands where the template is
    veh_len = VEHICLE_LENGTH_M
    if veh_len is None:
        veh_len = 1.2
        if box0 is not None:
            size = box0.GetSize()
            veh_len = max(0.6, min(2.0, max(size[0], size[1])))
    if prepared:
        o0 = prims[0][0].Get()
        start_xy = (o0[0], o0[1])
        start_yaw = _qyaw(prims[0][1].Get()) - base_yaw - yaw_off
    else:
        start_xy = (box0.GetMidpoint()[0], box0.GetMidpoint()[1]) if box0 is not None else (tt[0], tt[1])
        start_yaw = yaw_t                      # the model's +X is taken as forward
    oht_top = box0.GetMax()[2] if box0 is not None else oht_z

    # ---- route ------------------------------------------------------------
    track_nodes = []                           # junctions (machines are kept away from them)
    debug_z = 0.065

    def _route_xy():
        return list(ROUTE_XY), CORNER_RADIUS_M

    def _rail_roots():
        if RAIL_ROOT:
            roots = [RAIL_ROOT] if isinstance(RAIL_ROOT, str) else list(RAIL_ROOT)
            return [r for r in roots if stage.GetPrimAtPath(r).IsValid()]
        world = stage.GetDefaultPrim() if stage.GetDefaultPrim() else stage.GetPrimAtPath("/World")
        skip = {FLEET_PATH, template_path, TRACK_CACHE_PATH, GROUND_MACHINES_PATH, MAGAZINES_PATH,
                GROUND_MACHINE_TEMPLATE, MAGAZINE_TEMPLATE} | set(EXISTING_GROUND_MACHINES)
        roots = []
        for ch in world.GetChildren():
            if str(ch.GetPath()) in skip or not any(h in ch.GetName().lower() for h in RAIL_NAME_HINTS):
                continue
            if any(p.IsA(UsdGeom.Mesh) for p in Usd.PrimRange(ch, Usd.TraverseInstanceProxies())):
                roots.append(str(ch.GetPath()))
        return roots

    def _rail_triangles(roots):
        skip = [Sdf.Path(p) for p in (FLEET_PATH, template_path, TRACK_CACHE_PATH,
                                      GROUND_MACHINES_PATH, MAGAZINES_PATH)]
        out = []
        for r in roots:
            it = iter(Usd.PrimRange(stage.GetPrimAtPath(r), Usd.TraverseInstanceProxies()))
            for p in it:
                if any(p.GetPath().HasPrefix(s) for s in skip):
                    it.PruneChildren(); continue
                if not p.IsA(UsdGeom.Mesh):
                    continue
                if UsdGeom.Imageable(p).ComputeVisibility() == UsdGeom.Tokens.invisible:
                    continue
                m = UsdGeom.Mesh(p)
                pts, cnt, idx = (m.GetPointsAttr().Get(), m.GetFaceVertexCountsAttr().Get(),
                                 m.GetFaceVertexIndicesAttr().Get())
                if not pts or not cnt or not idx:
                    continue
                P = np.asarray(pts, dtype=float)
                C = np.asarray(cnt, dtype=np.int64)
                I = np.asarray(idx, dtype=np.int64)
                Mx = _wmat(p)
                M = np.array([[Mx[i][j] for j in range(4)] for i in range(4)], dtype=float)
                W = (np.c_[P, np.ones(len(P))] @ M)[:, :3]
                starts = np.cumsum(C) - C
                ntri = np.maximum(C - 2, 0)
                f = np.repeat(np.arange(len(C)), ntri)
                k = np.arange(ntri.sum()) - np.repeat(np.cumsum(ntri) - ntri, ntri)
                a, b, c = I[starts[f]], I[starts[f] + k + 1], I[starts[f] + k + 2]
                out.append(np.stack([W[a], W[b], W[c]], axis=1))
        return np.concatenate(out) if out else np.zeros((0, 3, 3))

    def _save_track(G, loop, key, z):
        stage.RemovePrim(Sdf.Path(TRACK_CACHE_PATH))
        UsdGeom.Xform.Define(stage, TRACK_CACHE_PATH)
        r = UsdGeom.BasisCurves.Define(stage, TRACK_CACHE_PATH + "/Route")
        pts = [Gf.Vec3f(float(x), float(y), z) for x, y in loop]
        r.CreatePointsAttr(Vt.Vec3fArray(pts))
        r.CreateCurveVertexCountsAttr([len(pts)])
        r.CreateTypeAttr("linear")
        r.CreateWrapAttr("periodic")
        r.MakeInvisible()                              # data only; Route_Debug shows it
        r.GetPrim().SetCustomDataByKey("railRoots", key)
        r.GetPrim().SetCustomDataByKey("startXY", Gf.Vec2d(*start_xy))
        nodes = [G.nodes[n] for n in G.nodes]
        j = UsdGeom.Points.Define(stage, TRACK_CACHE_PATH + "/Junctions")
        j.CreatePointsAttr(Vt.Vec3fArray([Gf.Vec3f(float(x), float(y), z) for x, y in nodes]))
        j.CreateWidthsAttr([0.08] * len(nodes))
        j.CreateDisplayColorAttr([Gf.Vec3f(0.9, 0.1, 0.1)])
        net = UsdGeom.BasisCurves.Define(stage, TRACK_CACHE_PATH + "/Track_Network")
        allp, counts = [], []
        for _, _, q in G.edges.values():
            allp += [Gf.Vec3f(float(x), float(y), z) for x, y in q]
            counts.append(len(q))
        net.CreatePointsAttr(Vt.Vec3fArray(allp))
        net.CreateCurveVertexCountsAttr(counts)
        net.CreateTypeAttr("linear")
        net.CreateWidthsAttr([0.02])
        net.CreateDisplayColorAttr([Gf.Vec3f(0.95, 0.8, 0.1)])
        if not SHOW_TRACK_NETWORK:
            net.MakeInvisible(); j.MakeInvisible()

    def _route_auto():
        roots = _rail_roots()
        if not roots:
            raise RuntimeError("no rail CAD found: set RAIL_ROOT to the prim that holds the rails "
                               "(names searched for: %s)" % ", ".join(RAIL_NAME_HINTS))
        key = ";".join(roots)
        cache = stage.GetPrimAtPath(TRACK_CACHE_PATH + "/Route")
        if cache.IsValid() and not REBUILD_TRACK and cache.GetCustomDataByKey("railRoots") == key:
            pts = cache.GetAttribute("points").Get()
            if pts:
                arr = np.array([(p[0], p[1]) for p in pts])
                if np.hypot(*(arr - np.asarray(start_xy)).T).min() < 0.6:
                    jn = stage.GetPrimAtPath(TRACK_CACHE_PATH + "/Junctions")
                    jp = jn.GetAttribute("points").Get() if jn.IsValid() else None
                    track_nodes.extend([(p[0], p[1]) for p in (jp or [])])
                    print("[OHT Fleet] using the saved track in %s (set REBUILD_TRACK = True to extract again)"
                          % TRACK_CACHE_PATH)
                    return [tuple(p) for p in arr.tolist()], 0.0, float(pts[0][2])
                print("[OHT Fleet] the OHT template moved off the saved track — extracting again")
        import time as _t
        t0 = _t.time()
        print("[OHT Fleet] extracting the track from %s ..." % ", ".join(roots))
        tris = _rail_triangles(roots)
        if len(tris) == 0:
            raise RuntimeError("the rail prims %s contain no meshes (not loaded?)" % key)
        bands = [RAIL_Z_RANGE] if RAIL_Z_RANGE else \
            [(oht_top - 0.30, oht_top + 0.15), (oht_top - 0.60, oht_top + 0.60), None]
        chosen = None
        for band in bands:
            sub = tris
            if band is not None:
                zmin, zmax = tris[:, :, 2].min(1), tris[:, :, 2].max(1)
                sub = tris[(zmax >= band[0]) & (zmin <= band[1])]
            if len(sub) < 50:
                continue
            G = extract_track(sub, TRACK_RESOLUTION_M, RAIL_PAIR_GAP_M, None, SPUR_PRUNE_M,
                              log=lambda *a: None)
            res = track_find_loop(G, start_xy, np.array([math.cos(start_yaw), math.sin(start_yaw)]),
                                  ROUTE_LOOP, ROUTE_VIA, JUNCTION_MAX_TURN_DEG, log=print)
            if res is None:
                continue
            if chosen is None or res[2] < chosen[2][2]:
                chosen = (band, G, res)
            if res[2] < 0.6:                   # the loop runs right under the template OHT
                break
        if chosen is None:
            raise RuntimeError("no closed loop found in the rails. Check RAIL_ROOT / RAIL_Z_RANGE "
                               "and that the OHT template stands on a rail")
        band, G, (pts, states, dist) = chosen
        loop = track_smooth_loop(pts)
        L = float(np.hypot(*np.diff(np.vstack([loop, loop[:1]]), axis=0).T).sum())
        z = float(band[1]) if band else oht_top
        _save_track(G, loop, key, z)
        track_nodes.extend([tuple(G.nodes[n]) for n in G.nodes])
        print("[OHT Fleet] track: %d rail triangles, height %s -> %d tracks, %d junctions; "
              "loop %.1f m over %d tracks (%.1f s)"
              % (len(tris), "%.2f..%.2f m" % band if band else "all", len(G.edges), len(G.nodes),
                 L, len(states), _t.time() - t0))
        if dist > 0.6:
            print("[OHT Fleet] WARNING: the template OHT is %.2f m from the loop — put it on the rail" % dist)
        return [tuple(p) for p in loop.tolist()], 0.0, z

    radius = CORNER_RADIUS_M
    if ROUTE_SOURCE == "auto":
        try:
            corners, radius, debug_z = _route_auto()
        except Exception as ex:
            import traceback
            traceback.print_exc()
            print("[OHT Fleet] automatic track failed (%s) — using ROUTE_XY" % ex)
            corners, radius = _route_xy()
    elif ROUTE_SOURCE == "prim" and ROUTE_PRIM:
        pts = stage.GetPrimAtPath(ROUTE_PRIM).GetAttribute("points").Get()
        corners = [(float(p[0]), float(p[1])) for p in pts]
        radius = 0.0 if len(corners) > 50 else CORNER_RADIUS_M
    else:
        corners, radius = _route_xy()
    if REVERSE_DIRECTION:
        corners.reverse()
    path = LoopPath(corners, radius)

    # a new model: hang it on the route where you placed it, keep its heading to the rail
    if not prepared:
        s_t, _ = path.project(start_xy)
        rx, ry, psi = path.pose(s_t)
        yaw_off = math.radians(YAW_OFFSET_DEG) + (yaw_t - psi)
        b0 = Mw_t * _T((-rx, -ry, -tt[2])) * _Rz(-yaw_t)
        for t_a, o_a, _, prim, _ in prims:
            prim.GetAttribute("xformOp:transform:ohtBase").Set(b0)
            _setv(t_a, Gf.Vec3d(rx, ry, oht_z))
            _setv(o_a, _qz(psi + yaw_off))

    # ---- the model's own (built-in) hoists
    builtin = []                    # per OHT: list of (writer, local vector for +1 m world Z)
    builtin_claws = []              # per OHT: list of (writer, local vector for 1 m outward, path)
    builtin_paths = []              # the hoist parts (cables under them are fixed at the bottom)
    clip_info = []                  # per OHT: (centre of the clip that moves, centres of the others)
    held_ref = [None, None]         # (box of the model's own magazine, box of the moving clip) on OHT_01
    builtin_box = None
    if USE_BUILTIN_HOIST:
        names, claw_names = set(), set()
        for _, _, _, prim, _ in prims:
            mine, skip, my_claws = [], None, []
            addon = prim.GetPath().AppendChild("Hoist_Unit")
            cands = []
            other_centers, chosen_center = [], None
            parent = stage.GetPrimAtPath(prim.GetPath().AppendPath(Sdf.Path(HOIST_CLIPS_PARENT)))
            if not BUILTIN_HOIST_PARTS and parent and parent.IsValid():
                clips = sorted([c for c in parent.GetChildren() if "clip" in c.GetName().lower()],
                               key=lambda c: c.GetName())
                centers = {c.GetName(): (_bbox(c).GetMidpoint() if _bbox(c) is not None else None) for c in clips}
                chosen = None
                if clips and HOIST_CLIP != "auto":
                    chosen = next((c for c in clips if c.GetName() == HOIST_CLIP), None)
                if clips and chosen is None:
                    mag = stage.GetPrimAtPath(prim.GetPath().AppendPath(Sdf.Path(MODEL_MAGAZINE)))
                    rm = _bbox(mag) if mag and mag.IsValid() else None
                    with_c = [c for c in clips if centers[c.GetName()] is not None]
                    if rm is not None and with_c:
                        mc = rm.GetMidpoint()
                        chosen = min(with_c, key=lambda c: math.hypot(centers[c.GetName()][0] - mc[0],
                                                                       centers[c.GetName()][1] - mc[1]))
                    else:
                        chosen = clips[0]
                if chosen is not None and prim is prims[0][3]:
                    mag_ref = stage.GetPrimAtPath(prim.GetPath().AppendPath(Sdf.Path(MODEL_MAGAZINE)))
                    held_ref[0] = _bbox(mag_ref) if mag_ref and mag_ref.IsValid() else None
                    held_ref[1] = _bbox(chosen)
                if chosen is not None:
                    cands = [chosen]
                    chosen_center = centers[chosen.GetName()]
                    other_centers = [centers[c.GetName()] for c in clips
                                     if c is not chosen and centers[c.GetName()] is not None]
            clip_info.append((chosen_center, other_centers))
            if not cands and BUILTIN_HOIST_PARTS:
                cands = [stage.GetPrimAtPath(prim.GetPath().AppendPath(Sdf.Path(rel)))
                         for rel in BUILTIN_HOIST_PARTS]
                cands = [c for c in cands if c and c.IsValid()]
                if not cands and prim is prims[0][3]:
                    print("[OHT Fleet] BUILTIN_HOIST_PARTS %s not found in the OHT — searching by name"
                          % BUILTIN_HOIST_PARTS)
            if not cands:
                cands = [p for p in Usd.PrimRange(prim)
                         if not p.GetPath().HasPrefix(addon)
                         and any(h in p.GetName().lower() for h in BUILTIN_HOIST_HINTS)
                         and not any(h in p.GetName().lower() for h in CABLE_NAME_HINTS)]
            for p in cands:
                if not p or not p.IsValid() or (skip and any(p.GetPath().HasPrefix(s) for s in skip)):
                    continue
                skip = (skip or []) + [p.GetPath()]          # whole part, not its children too
                xf = UsdGeom.Xformable(p)
                inv = xf.ComputeLocalToWorldTransform(Usd.TimeCode.Default()).GetInverse()
                op = xf.AddTranslateOp(UsdGeom.XformOp.PrecisionDouble, "builtinHoist")
                mine.append((_W(op.GetAttr()), inv.TransformDir(Gf.Vec3d(0, 0, 1))))
                names.add(p.GetName())
                builtin_paths.append(p.GetPath())
                fingers, taken = [], []
                for q in Usd.PrimRange(p):
                    if q == p or not any(h in q.GetName().lower() for h in BUILTIN_CLAW_HINTS):
                        continue
                    if any(q.GetPath().HasPrefix(t) for t in taken):
                        continue                      # a finger's own sub-parts
                    taken.append(q.GetPath())
                    r_q = _bbox(q)
                    if r_q is not None:
                        fingers.append((q, r_q.GetMidpoint()))
                if len(fingers) < 2:          # e.g. CLIP_1/CLIP holds the two finger parts
                    for q in Usd.PrimRange(p):
                        kids = [k for k in q.GetChildren() if _bbox(k) is not None]
                        if q != p and len(kids) >= 2 and any(h in q.GetName().lower() for h in BUILTIN_CLAW_HINTS):
                            fingers = [(k, _bbox(k).GetMidpoint()) for k in kids]
                            break
                if len(fingers) >= 2:
                    mid = sum((f[1] for f in fingers), Gf.Vec3d(0, 0, 0)) / len(fingers)
                    for q, cq in fingers:
                        dv = Gf.Vec3d(cq[0] - mid[0], cq[1] - mid[1], 0.0)
                        if dv.GetLength() < 1e-3:
                            continue
                        qx = UsdGeom.Xformable(q)
                        q_inv = qx.ComputeLocalToWorldTransform(Usd.TimeCode.Default()).GetInverse()
                        c_op = qx.AddTranslateOp(UsdGeom.XformOp.PrecisionDouble, "builtinClaw")
                        my_claws.append((_W(c_op.GetAttr()), q_inv.TransformDir(dv.GetNormalized()), q.GetPath()))
                        claw_names.add(q.GetName())
                if prim is prims[0][3]:
                    r = _bbox(p)
                    if r is not None:
                        builtin_box = r if builtin_box is None else Gf.Range3d(
                            Gf.Vec3d(*[min(builtin_box.GetMin()[i], r.GetMin()[i]) for i in range(3)]),
                            Gf.Vec3d(*[max(builtin_box.GetMax()[i], r.GetMax()[i]) for i in range(3)]))
            builtin.append(mine)
            builtin_claws.append(my_claws)
        if any(builtin):
            print("[OHT Fleet] hoist that goes down: %s, its fingers: %s"
                  % (", ".join(sorted(names)), ", ".join(sorted(claw_names)) or "none found"))
            for _, _, _, prim, _ in prims:
                hu = stage.GetPrimAtPath(prim.GetPath().AppendChild("Hoist_Unit"))
                if hu.IsValid():
                    UsdGeom.Imageable(hu).MakeInvisible()
                for rel in HIDE_MODEL_PARTS:
                    hp = stage.GetPrimAtPath(prim.GetPath().AppendPath(Sdf.Path(rel)))
                    if hp and hp.IsValid():
                        UsdGeom.Imageable(hp).MakeInvisible()
        else:
            builtin, builtin_claws = [], []
            print("[OHT Fleet] no built-in hoist found by name (%s) — using Hoist_Unit if the model has one"
                  % ", ".join(BUILTIN_HOIST_HINTS))

    # where the claws are relative to the OHT origin, in the OHT's travel frame
    claw_off = (0.0, 0.0)
    hu0 = stage.GetPrimAtPath(FLEET_PATH + "/OHT_01/Hoist_Unit")
    r_h = builtin_box if builtin_box is not None else (_bbox(hu0) if hu0.IsValid() else None)
    held_box = held_ref[0] if builtin else None
    held_rel_z = None
    ref_box = held_box if held_box is not None else r_h
    if held_box is not None:
        held_rel_z = held_box.GetMidpoint()[2] - prims[0][0].Get()[2]
        print("[OHT Fleet] held magazine position taken from %s" % MODEL_MAGAZINE)
    if ref_box is not None and CENTER_UNDER_CLAWS:
        o0 = prims[0][0].Get()
        cx, cy = ref_box.GetMidpoint()[0], ref_box.GetMidpoint()[1]
        th = -(_qyaw(prims[0][1].Get()) - base_yaw - yaw_off)
        dx, dy = cx - o0[0], cy - o0[1]
        claw_off = (math.cos(th) * dx - math.sin(th) * dy, math.sin(th) * dx + math.cos(th) * dy)
        print("[OHT Fleet] claws are %.3f m / %.3f m from the OHT origin" % claw_off)

    # how far the hoist must retract so a gripped magazine sits inside the OHT body
    carry_raise = CARRY_RAISE_M
    if carry_raise is None and builtin:
        carry_raise = 0.0
    if carry_raise is None and tmpl.GetCustomDataByKey("ohtGenerated"):
        carry_raise = 0.0
    if carry_raise is None:
        carry_raise = CARRY_RAISE_FALLBACK_M
        try:
            oht0 = prims[0][3]
            body_min = None
            for ch in oht0.GetChildren():
                if ch.GetName() in ("Hoist_Unit",):
                    continue
                r = _bbox(ch)
                if r is not None:
                    body_min = r.GetMin()[2] if body_min is None else min(body_min, r.GetMin()[2])
            r_mag = _bbox(stage.GetPrimAtPath(MAGAZINE_TEMPLATE))
            if body_min is not None and r_h is not None and r_mag is not None:
                mag_h = r_mag.GetMax()[2] - r_mag.GetMin()[2]
                mag_bottom_at_rest = r_h.GetMin()[2] + GRIP_DEPTH_M - mag_h
                carry_raise = max(0.0, min(2.0, body_min - mag_bottom_at_rest))
        except Exception as ex:
            print("[OHT Fleet] carry raise measure failed (%s) — using %.2f m" % (ex, carry_raise))

    hoist_scale = 1.0
    sc = prims[0][3].GetAttribute("xformOp:scale:oht")
    if sc and sc.Get() is not None and abs(sc.Get()[2]) > 1e-9:
        hoist_scale = abs(sc.Get()[2])

    if SHOW_ROUTE:
        c = UsdGeom.BasisCurves.Define(stage, FLEET_PATH + "/Route_Debug")
        pts = [Gf.Vec3f(x, y, debug_z) for x, y in path.xy] + [Gf.Vec3f(path.xy[0][0], path.xy[0][1], debug_z)]
        c.CreatePointsAttr(Vt.Vec3fArray(pts))
        c.CreateCurveVertexCountsAttr([len(pts)])
        c.CreateTypeAttr("linear")
        c.CreateWidthsAttr([0.03])
        c.CreateDisplayColorAttr([Gf.Vec3f(0.1, 0.8, 0.2)])

    # ---- ground machines -> stations
    def _port_of(prim):
        t = _world(prim)
        yaw = t[3]
        ox, oy, oz = PORT_OFFSET_LOCAL
        c, s_ = math.cos(yaw), math.sin(yaw)
        return (t[0] + c * ox - s_ * oy, t[1] + s_ * ox + c * oy, t[2] + oz)

    def _footprint(prim):
        r = _bbox(prim)
        return None if r is None else (r.GetMin()[0], r.GetMin()[1], r.GetMax()[0], r.GetMax()[1])

    def _overlap(a, b, margin=0.05):
        return not (a[2] + margin <= b[0] or b[2] + margin <= a[0] or
                    a[3] + margin <= b[1] or b[3] + margin <= a[1])

    def _claw_point(s):
        x, y, yaw = path.pose(s)
        return (x + math.cos(yaw) * claw_off[0] - math.sin(yaw) * claw_off[1],
                y + math.sin(yaw) * claw_off[0] + math.cos(yaw) * claw_off[1], yaw)

    gm_tmpl = stage.GetPrimAtPath(GROUND_MACHINE_TEMPLATE)

    def _auto_ports():
        """machine ports spread evenly along straight parts of the loop, away from junctions"""
        L = path.length
        yaw_gm = _yaw_of(gm_tmpl)
        rel = None
        if AUTO_MACHINE_YAW == "auto":
            s_g, d_g = path.project(_port_of(gm_tmpl)[:2])
            if d_g < 4.0:
                rel = yaw_gm - path.rail_pose(s_g)[2]
            else:
                print("[OHT Fleet] the template ground machine is %.1f m from the loop: "
                      "new machines keep its rotation" % d_g)
        ok = []
        for s in np.arange(0.0, L, 0.1):
            y0, y1 = path.rail_pose(s - 0.7)[2], path.rail_pose(s + 0.7)[2]
            if abs((y1 - y0 + math.pi) % (2 * math.pi) - math.pi) > math.radians(3):
                continue                       # in a curve
            x, y, _ = path.rail_pose(s)
            if any(math.hypot(x - a, y - b) < 1.5 for a, b in track_nodes):
                continue                       # too close to a junction
            ok.append(float(s))
        if not ok:
            print("[OHT Fleet] no straight track for machines found")
            return []
        ok = np.array(ok)
        n = max(1, AUTO_MACHINE_COUNT)
        chosen = []
        for i in range(n):
            target = (i + 0.5) * L / n
            d = np.abs((ok - target + L / 2) % L - L / 2)
            for j in np.argsort(d):
                s = ok[j]
                if d[j] > L / n / 2:
                    break
                if all(abs((s - c + L / 2) % L - L / 2) >= AUTO_MACHINE_MIN_GAP_M for c in chosen):
                    chosen.append(s)
                    break
        ports = []
        for s in sorted(chosen):
            px, py, yaw = _claw_point(s)        # load port right under the claws
            if AUTO_MACHINE_YAW == "rail":
                th = yaw + math.radians(AUTO_MACHINE_YAW_OFFSET_DEG)
            elif rel is not None:
                th = yaw + rel
            else:
                th = yaw_gm
            ports.append((px, py, th))
        return ports

    machines = [stage.GetPrimAtPath(p) for p in EXISTING_GROUND_MACHINES]
    machines = [m for m in machines if m.IsValid()]
    gm_root = stage.GetPrimAtPath(GROUND_MACHINES_PATH)
    keep_machines = KEEP_SCENE_LAYOUT and gm_root.IsValid() and len(gm_root.GetChildren()) > 0
    if keep_machines:
        kept = sorted(gm_root.GetChildren(), key=lambda p: p.GetName())
        machines += kept
        print("[OHT Fleet] keeping your %d machines in %s where they are" % (len(kept), GROUND_MACHINES_PATH))
    elif gm_root.IsValid():
        stage.RemovePrim(gm_root.GetPath())
    if not keep_machines and gm_tmpl.IsValid():
        if ROUTE_SOURCE == "auto" and AUTO_MACHINES:
            ports = _auto_ports()
        else:
            ports = [(px, py, _yaw_of(gm_tmpl)) for px, py in NEW_MACHINE_PORTS]
        if ports:
            UsdGeom.Xform.Define(stage, GROUND_MACHINES_PATH)
            Mg = _wmat(gm_tmpl)
            tg = Mg.ExtractTranslation()
            yg = math.atan2(Mg[0][1], Mg[0][0])
            boxes = [b for b in (_footprint(m) for m in machines) if b]
            ox, oy, _ = PORT_OFFSET_LOCAL
            for n_i, (px, py, th) in enumerate(ports):
                mx = px - (math.cos(th) * ox - math.sin(th) * oy)
                my = py - (math.sin(th) * ox + math.cos(th) * oy)
                p = "%s/GM_%02d" % (GROUND_MACHINES_PATH, n_i + 3)
                gm = _clone(GROUND_MACHINE_TEMPLATE, p)
                xf = UsdGeom.Xformable(gm)
                xf.ClearXformOpOrder()
                xf.AddTransformOp(UsdGeom.XformOp.PrecisionDouble, "ohtPlace").Set(
                    Mg * _T(-tg) * _Rz(th - yg) * _T((mx, my, tg[2])))
                UsdGeom.Imageable(gm).MakeVisible()
                if SKIP_OVERLAPPING_MACHINES:
                    fp = _footprint(gm)
                    if fp is not None and any(_overlap(fp, b) for b in boxes):
                        stage.RemovePrim(gm.GetPath())
                        print("[OHT Fleet] skipped machine at (%.2f, %.2f): would overlap another machine" % (px, py))
                        continue
                    if fp is not None:
                        boxes.append(fp)
                machines.append(gm)

    stations_s, station_names, slots = [], [], []
    for m in machines:
        port = _port_of(m)
        s, off = path.project(port[:2])
        if off > 0.5:
            print("[OHT Fleet] %s is %.2f m away from the OHT route — not used as a stop" % (m.GetName(), off))
            continue
        stations_s.append(s)
        station_names.append(m.GetName())
        x, y, _ = _claw_point(s)          # magazine sits right under the claws
        slots.append((x, y, port[2], _yaw_of(m)))
    print("[OHT Fleet] %d ground machines used as stops: %s" % (len(stations_s), ", ".join(station_names)))

    # ---- magazines
    mag_tmpl = stage.GetPrimAtPath(MAGAZINE_TEMPLATE)
    n_mag = NUM_MAGAZINES if NUM_MAGAZINES is not None else len(stations_s) // 2
    n_mag = max(0, min(n_mag, len(stations_s) - 1))
    mag_root = stage.GetPrimAtPath(MAGAZINES_PATH)
    if not KEEP_SCENE_LAYOUT and mag_root.IsValid():
        stage.RemovePrim(mag_root.GetPath())
        mag_root = stage.GetPrimAtPath(MAGAZINES_PATH)
    if (not mag_root.IsValid() or not mag_root.GetChildren()) and mag_tmpl.IsValid() and n_mag > 0:
        UsdGeom.Xform.Define(stage, MAGAZINES_PATH)
        Mm = _wmat(mag_tmpl)
        tm = Mm.ExtractTranslation()
        mag_base = Mm * _T(-tm) * _Rz(-math.atan2(Mm[0][1], Mm[0][0]))
        picks = list(range(0, len(stations_s), 2)) + list(range(1, len(stations_s), 2))
        for j, k in enumerate(picks[:n_mag]):
            x, y, z, yaw = slots[k]
            mp = _clone(MAGAZINE_TEMPLATE, "%s/MAG_%02d" % (MAGAZINES_PATH, j + 1))
            _setv(_attr(mp, "xformOp:translate", Sdf.ValueTypeNames.Double3), Gf.Vec3d(x, y, z))
            _setv(_attr(mp, "xformOp:orient", Sdf.ValueTypeNames.Quatd), _qz(yaw))
            _attr(mp, "xformOp:transform:magBase", Sdf.ValueTypeNames.Matrix4d).Set(mag_base)
            UsdGeom.Imageable(mp).MakeVisible()
        mag_root = stage.GetPrimAtPath(MAGAZINES_PATH)
        print("[OHT Fleet] created %d magazines from %s" % (min(n_mag, len(picks)), MAGAZINE_TEMPLATE))
    machine_mag = [None] * len(stations_s)
    mags = []          # per magazine: dict(t=translate attr, o=orient attr, pose=(x,y,z,yaw))
    kept_slots = set()
    existing = sorted(mag_root.GetChildren(), key=lambda p: p.GetName()) if mag_root.IsValid() else []
    existing.sort(key=lambda p: p.GetName() not in MAGAZINE_MACHINE_ASSIGNMENT)
    if existing:
        for mp in existing:
            name = mp.GetName()
            x, y, z, yaw = _world(mp)
            forced_machine = MAGAZINE_MACHINE_ASSIGNMENT.get(name)
            k = None
            if forced_machine:
                candidates = [i for i, mn in enumerate(station_names) if mn == forced_machine]
                if candidates and machine_mag[candidates[0]] is None:
                    k = candidates[0]
                    x, y, z, yaw = slots[k]            # snap onto the assigned machine
                    print("[OHT Fleet] positioning %s on %s" % (name, forced_machine))
            if k is None:
                free = [i for i in range(len(slots)) if machine_mag[i] is None]
                if not free:
                    print("[OHT Fleet] %s: no free machine left" % name)
                    continue
                k = min(free, key=lambda i: math.hypot(slots[i][0] - x, slots[i][1] - y))
                dist = math.hypot(slots[k][0] - x, slots[k][1] - y)
                if dist > MAG_MATCH_RADIUS_M:
                    print("[OHT Fleet] %s is %.2f m from %s and was not registered"
                          % (name, dist, station_names[k]))
                    continue
                if abs(z - slots[k][2]) > 0.3:
                    z = slots[k][2]

            # the magazine's transform: translate + orient (+ scale or its base matrix)
            _attr(mp, "xformOp:translate", Sdf.ValueTypeNames.Double3)
            _attr(mp, "xformOp:orient", Sdf.ValueTypeNames.Quatd)
            order = ["xformOp:translate", "xformOp:orient"]
            if mp.GetAttribute("xformOp:transform:magBase"):
                order.append("xformOp:transform:magBase")
            elif mp.GetAttribute("xformOp:scale"):
                order.append("xformOp:scale")
            mp.GetAttribute("xformOpOrder").Set(Vt.TokenArray(order))
            _setv(mp.GetAttribute("xformOp:translate"), Gf.Vec3d(x, y, z))
            _setv(mp.GetAttribute("xformOp:orient"), _qz(yaw))
            UsdGeom.Imageable(mp).MakeVisible()
            if MAGAZINE_INSTANCEABLE:
                mp.SetInstanceable(True)

            mags.append({
                "t": _W(mp.GetAttribute("xformOp:translate")),
                "o": _W(mp.GetAttribute("xformOp:orient")),
                "pose": (x, y, z, yaw),
                "attach": None,
                "prim": mp,
            })
            machine_mag[k] = len(mags) - 1
            slots[k] = (x, y, z, yaw)
            kept_slots.add(k)

            # align the machine stop point with the gripper
            rb = _bbox(mp)
            cx, cy = (rb.GetMidpoint()[0], rb.GetMidpoint()[1]) if rb is not None else (x, y)
            s0, _ = path.project((cx, cy))
            pyaw = path.pose(s0)[2]
            ox_ = math.cos(pyaw) * claw_off[0] - math.sin(pyaw) * claw_off[1]
            oy_ = math.sin(pyaw) * claw_off[0] + math.cos(pyaw) * claw_off[1]
            s_k = path.project((cx - ox_, cy - oy_))[0]
            px_, py_, _ = path.pose(s_k)
            dx_ = px_ + ox_ - cx
            dy_ = py_ + oy_ - cy
            if math.hypot(dx_, dy_) < 0.5:
                x += dx_
                y += dy_
            mags[-1]["pose"] = (x, y, z, yaw)
            slots[k] = (x, y, z, yaw)
            stations_s[k] = s_k

        if HIDE_ORIGINAL_MAGAZINE and mag_tmpl.IsValid():
            UsdGeom.Imageable(mag_tmpl).MakeInvisible()
        print("[OHT Fleet] %d magazines placed on: %s"
              % (len(mags), ", ".join(station_names[k] for k in range(len(stations_s)) if machine_mag[k] is not None)))
    elif n_mag > 0:
        print("[OHT Fleet] no magazines (and no template %s) — OHTs will only move the hoist" % MAGAZINE_TEMPLATE)

    def _set_mag_pose(m, x, y, z, yaw):
        m["t"].set(Gf.Vec3d(x, y, z))
        m["o"].set(_qz(yaw))

    for m in mags:
        _set_mag_pose(m, *m["pose"])

    # pick geometry, measured once
    claw_rel_z = mag_top_rel = mag_mid_rel = None
    if r_h is not None:
        claw_rel_z = r_h.GetMin()[2] - prims[0][0].Get()[2]
    if mags:
        r_m1 = _bbox(mags[0]["prim"])
        if r_m1 is not None:
            mag_top_rel = r_m1.GetMax()[2] - mags[0]["pose"][2]
            mag_mid_rel = r_m1.GetMidpoint()[2] - mags[0]["pose"][2]

    def _vdrop(v):
        return v.drop if v.drop is not None else drop_m

    def _lift(v):
        """gripper height relative to its rest position (m, + = up)"""
        carrying = v.mag is not None and v.mag < len(mags) and mags[v.mag]["attach"] is not None
        return -_vdrop(v) * v.hoist + (carry_raise if carrying else 0.0) * (1.0 - v.hoist)

    def _gripper(v):
        x, y, yaw = path.pose(v.s)
        return x, y, oht_z + _lift(v), yaw

    sim = None   # set below; the callbacks only run after it exists

    def on_arrive(v, k, action):
        """Decide how far to lower for this job, from the real geometry."""
        v.drop = drop_m
        if action == "drop" and v.mag is not None and v.mag < len(mags):
            v.drop = max(0.05, mags[v.mag]["pose"][2] - slots[k][2] - carry_raise)
        elif action == "pick" and sim.machine_mag[k] is not None:
            mz = mags[sim.machine_mag[k]]["pose"][2]
            d = None
            if held_rel_z is not None and mag_mid_rel is not None:
                d = (oht_z + held_rel_z) - (mz + mag_mid_rel)
            elif claw_rel_z is not None and mag_top_rel is not None:
                d = (oht_z + claw_rel_z) - (mz + mag_top_rel - GRIP_DEPTH_M)
            if d is not None and 0.1 < d < 10:
                v.drop = d
        if LOG_JOBS and action:
            print("[OHT Fleet] OHT_%02d lowering %.2f m to %s" % (v.idx + 1, v.drop, action))

    def on_event(v, k, kind, mag_id):
        if mag_id is None or mag_id >= len(mags):
            return
        m = mags[mag_id]
        gx, gy, gz, gyaw = _gripper(v)
        if kind == "pick":
            mx, my, mz, myaw = m["pose"]
            dx, dy = mx - gx, my - gy
            c, s_ = math.cos(-gyaw), math.sin(-gyaw)
            m["attach"] = (c * dx - s_ * dy, s_ * dx + c * dy, mz - gz, myaw - gyaw)
        else:
            m["attach"] = None    # released: it stays where it was set down
        if LOG_JOBS:
            print("[OHT Fleet] OHT_%02d %s %s at %s"
                  % (v.idx + 1, "picked up" if kind == "pick" else "dropped off", m["prim"].GetName(), station_names[k]))

    sim = FleetSim(path, NUM_OHT, veh_len, stations_s, machine_mag)
    sim.on_event = on_event
    sim.on_arrive = on_arrive
    timeline = omni.timeline.get_timeline_interface()

    # ---- hoist cables: attach points in the OHT's own frame
    cable_pts_local = None
    anchors = tmpl.GetCustomDataByKey("ohtCableAnchors")
    if anchors:
        cable_pts_local = [(a[0], a[1], a[2]) for a in anchors]
    ct = stage.GetPrimAtPath(CABLE_TEMPLATE)
    t_pos = t_attr.Get() if t_attr else None
    t_ori = o_attr0.Get() if o_attr0 else None
    if cable_pts_local is None and ct.IsValid() and ct.GetAttribute("points").Get() \
            and t_pos is not None and t_ori is not None:
        pts = ct.GetAttribute("points").Get()
        th = -_qyaw(t_ori)
        c_, s2 = math.cos(th), math.sin(th)
        cable_pts_local = []
        for i in range(0, len(pts) - 1, 2):
            top = max(pts[i], pts[i + 1], key=lambda p: p[2])
            dx, dy = top[0] - t_pos[0], top[1] - t_pos[1]
            cable_pts_local.append((c_ * dx - s2 * dy, s2 * dx + c_ * dy, top[2] - t_pos[2]))
    if cable_pts_local is None:
        cable_pts_local = [(sx * 0.1, sy * 0.05, -0.096) for sx in (-1, 1) for sy in (-1, 1)]
    if held_ref[1] is not None:
        cb = held_ref[1]
        o0 = prims[0][0].Get()
        th = -_qyaw(prims[0][1].Get())
        c_, s2 = math.cos(th), math.sin(th)
        mx_, my_ = cb.GetMidpoint()[0], cb.GetMidpoint()[1]
        hx, hy = cb.GetSize()[0] * 0.3, cb.GetSize()[1] * 0.3
        cable_pts_local = []
        for sx_ in (-1, 1):
            for sy_ in (-1, 1):
                dx, dy = mx_ + sx_ * hx - o0[0], my_ + sy_ * hy - o0[1]
                cable_pts_local.append((c_ * dx - s2 * dy, s2 * dx + c_ * dy, cb.GetMax()[2] - o0[2]))
    cable_ops = []

    def _make_drawn_cables():
        UsdGeom.Scope.Define(stage, FLEET_PATH + "/Hoist_Cables")
        for i in range(NUM_OHT):
            grp = UsdGeom.Xform.Define(stage, "%s/Hoist_Cables/OHT_%02d" % (FLEET_PATH, i + 1))
            ops = []
            for j in range(len(cable_pts_local)):
                cyl = UsdGeom.Cylinder.Define(stage, "%s/Hoist_Cables/OHT_%02d/c%d" % (FLEET_PATH, i + 1, j))
                cyl.CreateRadiusAttr(CABLE_WIDTH_M / 2)
                cyl.CreateHeightAttr(1.0)
                cyl.CreateAxisAttr(UsdGeom.Tokens.z)
                cyl.CreateDisplayColorAttr([Gf.Vec3f(*CABLE_COLOR)])
                ops.append((_W(cyl.AddTranslateOp().GetAttr()), _W(cyl.AddScaleOp().GetAttr())))
            cable_ops.append((_W(grp.CreateVisibilityAttr()), ops))

    if SHOW_CABLES is True:
        _make_drawn_cables()

    def _update_cables():
        for v, (vis, ops) in zip(sim.veh, cable_ops):
            length = -_lift(v) + 0.002
            if length < 0.005:
                vis.set(UsdGeom.Tokens.invisible)
                continue
            vis.set(UsdGeom.Tokens.inherited)
            x, y, yaw = path.pose(v.s)
            th = yaw + yaw_off + base_yaw
            c_, s2 = math.cos(th), math.sin(th)
            for (dx, dy, dz), (t_op, s_op) in zip(cable_pts_local, ops):
                top = oht_z + dz
                t_op.set(Gf.Vec3d(x + c_ * dx - s2 * dy, y + s2 * dx + c_ * dy, top - length / 2))
                s_op.set(Gf.Vec3f(1, 1, length))

    # ---- the model's own cables/belts: stretch them with the hoist
    model_cables = []
    if MODEL_CABLES:
        found_names = set()
        for i_oht, (_, _, _, prim, _) in enumerate(prims):
            mine, skip = [], None
            mc, others = clip_info[i_oht] if i_oht < len(clip_info) else (None, [])
            groups = []
            for p in Usd.PrimRange(prim):
                if skip and p.GetPath().HasPrefix(skip):
                    continue
                if any(h in p.GetName().lower() for h in CABLE_NAME_HINTS) and UsdGeom.Xformable(p):
                    skip = p.GetPath()
                    kids = [k for k in p.GetChildren() if _bbox(k) is not None]
                    groups += kids if len(kids) >= 2 else [p]
            for p in groups:
                r = _bbox(p)
                if r is None or r.GetSize()[2] < 1e-6:
                    continue
                if mc is not None and others:
                    bc = r.GetMidpoint()
                    d_me = math.hypot(bc[0] - mc[0], bc[1] - mc[1])
                    if any(math.hypot(bc[0] - o[0], bc[1] - o[1]) < d_me for o in others):
                        continue
                on_hoist = "/Hoist_Unit/" in str(p.GetPath()) or \
                    any(p.GetPath().HasPrefix(b) for b in builtin_paths)
                c = r.GetMidpoint()
                pivot_w = Gf.Vec3d(c[0], c[1], r.GetMin()[2] if on_hoist else r.GetMax()[2])
                inv = UsdGeom.Xformable(p).ComputeLocalToWorldTransform(Usd.TimeCode.Default()).GetInverse()
                pivot = inv.Transform(pivot_w)
                d = inv.TransformDir(Gf.Vec3d(0, 0, 1))
                axis = max(range(3), key=lambda i: abs(d[i]))
                xf = UsdGeom.Xformable(p)
                xf.AddTranslateOp(UsdGeom.XformOp.PrecisionDouble, "cablePivot").Set(pivot)
                s_op = xf.AddScaleOp(UsdGeom.XformOp.PrecisionDouble, "cableStretch")
                s_op.Set(Gf.Vec3d(1, 1, 1))
                xf.AddTranslateOp(UsdGeom.XformOp.PrecisionDouble, "cablePivotInv").Set(-pivot)
                mine.append((_W(s_op.GetAttr()), axis, r.GetSize()[2]))
                found_names.add(p.GetName())
            model_cables.append(mine)
        n_found = sum(len(m) for m in model_cables)
        if n_found:
            print("[OHT Fleet] using %d cables from your OHT model (%s)"
                  % (n_found // max(1, len(prims)), ", ".join(sorted(found_names))))
    if SHOW_CABLES == "auto" and not cable_ops and not any(model_cables):
        _make_drawn_cables()
        print("[OHT Fleet] drawing 4 cables on top of the gripper")

    def _update_model_cables():
        for v, mine in zip(sim.veh, model_cables):
            lift = _lift(v)
            for s_w, axis, rest_len in mine:
                k = max(1e-3, rest_len - lift) / rest_len
                s = [1.0, 1.0, 1.0]
                s[axis] = k
                s_w.set(Gf.Vec3d(*s))

    writers = [(_W(t_a), _W(o_a), _W(h_a) if h_a else None, claws) for t_a, o_a, h_a, _, claws in prims]

    def write_poses():
        with Sdf.ChangeBlock():
            for v, (t_a, o_a, h_a, claws) in zip(sim.veh, writers):
                x, y, yaw = path.pose(v.s)
                t_a.set(Gf.Vec3d(x, y, oht_z))
                o_a.set(_qz(yaw + yaw_off) * base_q)
                if h_a:
                    h_a.set(Gf.Vec3d(0, 0, _lift(v) / hoist_scale))
                if builtin:
                    lift = _lift(v)
                    for w, d in builtin[v.idx]:
                        w.set(d * lift)
                    for w, d, _ in builtin_claws[v.idx]:
                        w.set(d * (-v.claw))         # + claw = closed (inward)
                for c_attr, rest in claws:
                    inward = -1.0 if rest[0] > 0 else 1.0
                    c_attr.set(Gf.Vec3d(rest[0] + inward * v.claw, rest[1], rest[2]))
                if v.mag is not None and v.mag < len(mags) and mags[v.mag]["attach"]:
                    m = mags[v.mag]
                    ax, ay, az, ayaw = m["attach"]
                    gx, gy, gz, gyaw = _gripper(v)
                    c, s_ = math.cos(gyaw), math.sin(gyaw)
                    m["pose"] = (gx + c * ax - s_ * ay, gy + s_ * ax + c * ay, gz + az, gyaw + ayaw)
                    _set_mag_pose(m, *m["pose"])
            _update_cables()
            _update_model_cables()

    write_poses()

    # Kinematic physics: rigid bodies would otherwise overwrite our positions
    n_kin = 0
    for _, _, _, prim, _ in prims:
        for p in Usd.PrimRange(prim):
            if p.HasAPI(UsdPhysics.RigidBodyAPI):
                UsdPhysics.RigidBodyAPI(p).CreateKinematicEnabledAttr(True)
                n_kin += 1
    if KINEMATIC_COLLIDERS:
        roots = [pr for _, _, _, pr, _ in prims] + [m["prim"] for m in mags]
        for root in roots:
            has_col = has_rb = False
            for p in Usd.PrimRange(root, Usd.TraverseInstanceProxies()):
                has_col = has_col or p.HasAPI(UsdPhysics.CollisionAPI)
                has_rb = has_rb or p.HasAPI(UsdPhysics.RigidBodyAPI)
            if has_col and not has_rb:
                UsdPhysics.RigidBodyAPI.Apply(root).CreateKinematicEnabledAttr(True)
                n_kin += 1
    if n_kin:
        print("[OHT Fleet] %d moving objects set to kinematic physics bodies" % n_kin)

    import time
    import traceback

    class _Handle:
        def __init__(self):
            self.sim = sim
            self.last = None
            self.errors = 0
            self.frames = 0
            self.sub = None
            self.observer = None
            try:   # Kit 105/106 (Isaac Sim 4.x)
                self.sub = omni.kit.app.get_app().get_update_event_stream().create_subscription_to_pop(
                    self._on_update, name="oht_fleet_controller")
            except Exception:   # newer Kit (Isaac Sim 5.x / 6.x)
                import carb.eventdispatcher
                self.observer = carb.eventdispatcher.get_eventdispatcher().observe_event(
                    event_name=omni.kit.app.GLOBAL_EVENT_UPDATE,
                    on_event=self._on_update, observer_name="oht_fleet_controller")

        def _on_update(self, *_):
            now = time.perf_counter()
            dt = 0.0 if self.last is None else now - self.last
            self.last = now
            if RUN_ONLY_WHEN_PLAYING and not timeline.is_playing():
                return
            try:
                t0 = time.perf_counter()
                self.sim.step(dt)
                write_poses()
                self.frames += 1
                if PROFILE_EVERY_S:
                    self._prof(dt, time.perf_counter() - t0)
                if self.frames == 30:
                    v = self.sim.veh[0]
                    print("[OHT Fleet] running — OHT_01 speed %.2f m/s, state %s" % (v.v, v.state))
            except Exception:
                self.errors += 1
                if self.errors <= 3:
                    print("[OHT Fleet] ERROR in update:\n" + traceback.format_exc())

        def _prof(self, dt, used):
            p = getattr(self, "_p", None)
            if p is None:
                p = self._p = {"t": 0.0, "n": 0, "used": 0.0, "max": 0.0, "fmax": 0.0}
            p["t"] += dt; p["n"] += 1; p["used"] += used
            p["max"] = max(p["max"], used); p["fmax"] = max(p["fmax"], dt)
            if p["t"] >= PROFILE_EVERY_S:
                frame = p["t"] / p["n"] * 1000
                script = p["used"] / p["n"] * 1000
                share = 100 * script / frame if frame else 0
                print("[OHT Fleet] %.0f FPS | frame %.1f ms (worst %.0f) | this script %.2f ms (worst %.1f) = %.0f%% of the frame | %s"
                      % (1000 / frame if frame else 0, frame, p["fmax"] * 1000, script, p["max"] * 1000, share,
                         "playing" if timeline.is_playing() else "not playing"))
                self._p = None

        def stop(self):
            if self.sub:
                self.sub.unsubscribe()
                self.sub = None
            self.observer = None
            print("[OHT Fleet] stopped")

    builtins._oht_fleet = _Handle()
    print("[OHT Fleet] %d OHTs on a %.1f m loop (%s route), vehicle length %.2f m, OHT z %.3f.%s"
          % (NUM_OHT, path.length, ROUTE_SOURCE, veh_len, oht_z,
             " Press PLAY." if RUN_ONLY_WHEN_PLAYING else " Moving now."))


