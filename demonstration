def offset_route(corners, dx=0.0, dy=0.0):
    """copy of a loop shifted by (dx, dy) metres"""
    return [(c[0] + dx, c[1] + dy) + tuple(c[2:]) for c in corners]


def bay_loop(lane_y):
    """lane (eastbound) -> LEFT up the east vertical -> LEFT onto the top line
    (westbound) -> LEFT down the west vertical -> LEFT back into the lane.
    Only uses curves that exist on the rail. reverse=True drives it clockwise
    (all RIGHT turns) over the same curves."""
    return [(X_WEST, lane_y), (X_EAST, lane_y), (X_EAST, Y_TOP), (X_WEST, Y_TOP)]


