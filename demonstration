# Route geometry
# ---------------------------------------------------------------------------
class LoopPath:
    def __init__(self, corners, radius, step=0.02, name="Loop"):
        self.name = name
        pts = self._round_corners(corners, radius)
        pts.append(pts[0])
        cum = [0.0]
        for a, b in zip(pts[:-1], pts[1:]):
            cum.append(cum[-1] + math.hypot(b[0] - a[0], b[1] - a[1]))
        total = cum[-1]
        cnt = max(8, int(round(total / step)))
        d = total / cnt
        self.xy, j = [], 0
        for k in range(cnt):
            s = k * d
            while cum[j + 1] < s:
                j += 1
            seg = cum[j + 1] - cum[j]
            f = 0.0 if seg < 1e-9 else (s - cum[j]) / seg
            a, b = pts[j], pts[j + 1]
            self.xy.append((a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f))

        self.s = [0.0]
        for i in range(1, len(self.xy) + 1):
            a, b = self.xy[i - 1], self.xy[i % len(self.xy)]
            self.s.append(self.s[-1] + math.hypot(b[0] - a[0], b[1] - a[1]))
        self.length = self.s[-1]
        self.n = len(self.xy)
        self.ds = self.length / self.n

        self.yaw = []
        for i in range(self.n):
            a, b = self.xy[i - 1], self.xy[(i + 1) % self.n]
            self.yaw.append(math.atan2(b[1] - a[1], b[0] - a[0]))

        w = max(1, int(0.5 / self.ds))
        raw = []
        for i in range(self.n):
            dyaw = self.yaw[(i + w) % self.n] - self.yaw[i - w]
            dyaw = (dyaw + math.pi) % (2 * math.pi) - math.pi
            kappa = abs(dyaw) / (2 * w * self.ds)
            raw.append(V_MAX if kappa < 1e-3 else min(V_MAX, math.sqrt(V_CURVE_LAT_ACC / kappa)))
        self.vlim = [min(raw[(i + jj) % self.n] for jj in range(-w, w + 1)) for i in range(self.n)]
        for _ in range(2):
            for i in range(self.n - 1, -1, -1):
                nxt = self.vlim[(i + 1) % self.n]
                self.vlim[i] = min(self.vlim[i], math.sqrt(nxt * nxt + 2 * B_COMFORT * self.ds))
            for i in range(self.n):
                prv = self.vlim[i - 1]
                self.vlim[i] = min(self.vlim[i], math.sqrt(prv * prv + 2 * A_MAX * self.ds))

    @staticmethod
    def _round_corners(c, r):
        """sharp corner points -> true circular arcs (like real rail curves)"""
        out, n = [], len(c)
        for i in range(n):
            p0, p1, p2 = c[i - 1], c[i], c[(i + 1) % n]
            rr = p1[2] if len(p1) > 2 else r
            v1 = (p1[0] - p0[0], p1[1] - p0[1]); l1 = math.hypot(*v1)
            v2 = (p2[0] - p1[0], p2[1] - p1[1]); l2 = math.hypot(*v2)
            if l1 < 1e-6 or l2 < 1e-6:
                continue
            u1 = (v1[0] / l1, v1[1] / l1); u2 = (v2[0] / l2, v2[1] / l2)
            turn = math.atan2(u1[0] * u2[1] - u1[1] * u2[0], u1[0] * u2[0] + u1[1] * u2[1])
            if abs(turn) < math.radians(1) or rr <= 0:
                out.append((p1[0], p1[1])); continue
            t = rr * math.tan(abs(turn) / 2)
            lim = 0.5 * min(l1, l2)
            if t > lim:
                t = lim; rr = t / math.tan(abs(turn) / 2)
            a = (p1[0] - u1[0] * t, p1[1] - u1[1] * t)
            side = 1.0 if turn > 0 else -1.0
            cx, cy = a[0] - side * u1[1] * rr, a[1] + side * u1[0] * rr
            a0 = math.atan2(a[1] - cy, a[0] - cx)
            m = max(4, int(abs(turn) / math.radians(2)))
            for k in range(m + 1):
                ang = a0 + turn * k / m
                out.append((cx + rr * math.cos(ang), cy + rr * math.sin(ang)))
        return out

    def vlim_at(self, s):
        s = self.wrap(s)
        i = min(self.n - 1, int(s / self.ds))
        f = (s - i * self.ds) / self.ds
        a, b = self.vlim[i] ** 2, self.vlim[(i + 1) % self.n] ** 2
        return math.sqrt(a + (b - a) * f)

    def wrap(self, s):
        return s % self.length

    def index(self, s):
        return int(self.wrap(s) / self.ds) % self.n

    def rail_pose(self, s):
        s = self.wrap(s)
        i = min(self.n - 1, int(s / self.ds))
        j = (i + 1) % self.n
        f = (s - i * self.ds) / self.ds
        x = self.xy[i][0] + (self.xy[j][0] - self.xy[i][0]) * f
        y = self.xy[i][1] + (self.xy[j][1] - self.xy[i][1]) * f
        return x, y, self.yaw[i]

    def pose(self, s):
        if BOGIE_HALF_SPACING_M <= 0:
            return self.rail_pose(s)
        fx, fy, _ = self.rail_pose(s + BOGIE_HALF_SPACING_M)
        rx, ry, _ = self.rail_pose(s - BOGIE_HALF_SPACING_M)
        return (fx + rx) / 2, (fy + ry) / 2, math.atan2(fy - ry, fx - rx)

    def project(self, xy):
        best, bi = 1e18, 0
        for i, p in enumerate(self.xy):
            d = (p[0] - xy[0]) ** 2 + (p[1] - xy[1]) ** 2
            if d < best:
                best, bi = d, i
        return bi * self.ds, math.sqrt(best)

    def ahead(self, s_from, s_to):
        return (s_to - s_from) % self.length


# ---------------------------------------------------------------------------
# Traffic logic — one FleetSim per loop, SharedTraffic couples the loops
# ---------------------------------------------------------------------------
def _ease(t):
    t = max(0.0, min(1.0, t))
    return t * t * (3 - 2 * t)


class Vehicle:
    def __init__(self, idx, s, path=None, loop=""):
        self.idx = idx            # GLOBAL index over all loops (OHT_01, OHT_02, ...)
        self.path = path          # the loop this OHT drives on
        self.loop = loop
        self.s = s
        self.v = 0.0
        self.state = "drive"      # drive | lower | grip | raise
        self.timer = 0.0
        self.hoist = 0.0
        self.passes = {}
        self.target = None
        self.target_dist = 0.0
        self.mag = None
        self.action = None
        self.claw = 0.0
        self.drop = None


class FleetSim:
    def __init__(self, path, n, veh_len, stations_s, machine_mag=None, idx_offset=0, name="Loop"):
        self.path, self.L, self.name = path, veh_len, name
        self.stations_s = stations_s
        self.machine_mag = list(machine_mag) if machine_mag else [None] * len(stations_s)
        self.gk = list(range(len(stations_s)))   # local station -> global machine index
        need = n * (veh_len + MIN_GAP_M + 0.5)
        if need > path.length:
            raise ValueError("%s is %.1f m but %d OHTs need %.1f m. Use fewer OHTs on it or a longer loop."
                             % (name, path.length, n, need))
        spacing = path.length / max(1, n)
        self.veh = [Vehicle(idx_offset + i, i * spacing, path, name) for i in range(n)]
        self.min_gap_seen = 1e9
        self.on_event = None
        self.on_arrive = None
        for v in self.veh:
            self._next_target(v)

    def own_leaders(self):
        """{vehicle idx: (centre distance ahead, leader)} using only this loop"""
        out = {}
        for v in self.veh:
            best = None
            for o in self.veh:
                if o is v:
                    continue
                d = self.path.ahead(v.s, o.s)
                if best is None or d < best[0]:
                    best = (d, o, o.v)
            out[v.idx] = best
        return out

    def gap_to_leader(self, v):
        lead = self.own_leaders().get(v.idx)
        if lead is None:
            return float("inf"), None
        return lead[0] - self.L, lead[1]

    def _next_target(self, v):
        v.target = None
        if not self.stations_s:
            return
        want_loaded = v.mag is None
        taken = {o.target[0] for o in self.veh if o is not v and o.target}
        best = None
        for k, ss in enumerate(self.stations_s):
            if k in taken or (self.machine_mag[k] is not None) != want_loaded:
                continue
            d = self.path.ahead(v.s, ss)
            if d < 0.05:
                continue
            if best is None or d < best[0]:
                best = (d, k, ss)
        if best:
            d, k, ss = best
            v.target, v.target_dist = (k, ss), d

    def step(self, dt):
        """stand-alone stepping (one loop, no shared rail). The fleet uses SharedTraffic."""
        dt = min(dt, 0.25)
        n = max(1, int(math.ceil(dt / MAX_SUBSTEP_S)))
        for _ in range(n):
            self._substep(dt / n, self.own_leaders())

    def _substep(self, dt, leaders):
        """leaders: {vehicle idx: (centre distance ahead, leader, leader speed) or None},
        computed for ALL vehicles before anybody moves in this substep."""
        for v in self.veh:
            if v.state != "drive":
                self._station_work(v, dt)
                continue
            lead = leaders.get(v.idx)
            if lead is None:
                v_lead_lim, max_move = V_MAX, 1e9
            else:
                dist, _, lv = lead
                free = dist - self.L - MIN_GAP_M
                max_move = free
                if free <= 0:
                    v_lead_lim = 0.0
                else:
                    v_lead_lim = min(math.sqrt(lv ** 2 + 2 * B_COMFORT * free),
                                     lv + free / TIME_HEADWAY)
            v_curve = self.path.vlim_at(v.s + v.v * dt)
            if v.target is None:
                self._next_target(v)
            v_stn = V_MAX
            if v.target:
                ds = max(0.0, v.target_dist)
                v_stn = math.sqrt(2 * B_COMFORT * max(0.0, ds - v.v * dt))
                if ds <= 1e-4:
                    k = v.target[0]
                    v.s, v.v, v.state, v.timer = v.target[1], 0.0, "lower", 0.0
                    if v.mag is None and self.machine_mag[k] is not None:
                        v.action = "pick"
                    elif v.mag is not None and self.machine_mag[k] is None:
                        v.action = "drop"
                    else:
                        v.action = None
                    if self.on_arrive:
                        self.on_arrive(v, k, v.action)
                    continue
            v_target = min(V_MAX, v_lead_lim, v_curve, v_stn)
            if v_target >= v.v:
                v.v = min(v_target, v.v + A_MAX * dt)
            else:
                v.v = max(v_target, v.v - B_EMERGENCY * dt)
            move = min(v.v * dt, max(0.0, max_move))
            if v.target:
                move = min(move, max(0.0, v.target_dist))
            if move < v.v * dt:
                v.v = move / dt
            v.s = self.path.wrap(v.s + move)
            if v.target:
                v.target_dist -= move

    def _station_work(self, v, dt):
        v.timer += dt
        k = v.target[0]
        if v.state == "lower":
            v.hoist = _ease(v.timer / HOIST_TIME_S)
            if v.action == "pick":
                v.claw = -CLAW_OPEN_M * _ease(v.timer / (0.4 * HOIST_TIME_S))
            if v.timer >= HOIST_TIME_S:
                v.state, v.timer, v.hoist = "grip", 0.0, 1.0
        elif v.state == "grip":
            f = _ease(v.timer / GRIP_TIME_S)
            if v.action == "pick":
                v.claw = -CLAW_OPEN_M + (CLAW_CLOSE_M + CLAW_OPEN_M) * f
            elif v.action == "drop":
                v.claw = CLAW_CLOSE_M - (CLAW_CLOSE_M + CLAW_OPEN_M) * f
            if v.timer >= GRIP_TIME_S:
                if v.action == "pick":
                    v.mag, self.machine_mag[k] = self.machine_mag[k], None
                    if self.on_event:
                        self.on_event(v, k, "pick", v.mag)
                elif v.action == "drop":
                    mag, v.mag = v.mag, None
                    self.machine_mag[k] = mag
                    if self.on_event:
                        self.on_event(v, k, "drop", mag)
                v.state, v.timer = "raise", 0.0
        elif v.state == "raise":
            v.hoist = 1.0 - _ease(v.timer / HOIST_TIME_S)
            if v.action == "drop":
                v.claw = -CLAW_OPEN_M * (1.0 - _ease((v.timer / HOIST_TIME_S - 0.1) / 0.5))
            if v.timer >= HOIST_TIME_S:
                v.state, v.hoist, v.action = "drive", 0.0, None
                self._next_target(v)


class SharedTraffic:
    """Couples the loops. Where two loops run on the same rail, an OHT keeps
    its distance to OHTs of the other loop too. Before a merge, the OHT that
    is closer to the merge point goes first; the other one treats it as if it
    were already driving in front of it (so they zip in without touching)."""

    def __init__(self, sims, tol=SHARED_TOL_M, look=LOOKAHEAD_M):
        self.sims = sims
        self.paths = [s.path for s in sims]
        self.look = look
        self.L = sims[0].L if sims else 1.2
        n = len(sims)
        self.map = [[None] * n for _ in range(n)]       # map[j][i][k]: sample k of loop j -> s on loop i
        self.merges = [[[] for _ in range(n)] for _ in range(n)]
        self.diverges = [[[] for _ in range(n)] for _ in range(n)]
        self.shared_len = {}
        self.head_on = []
        for i in range(n):
            for j in range(n):
                if i == j:
                    continue
                m, opp = self._match(self.paths[i], self.paths[j], tol)
                if opp and i < j:
                    self.head_on.append((self.paths[i].name, self.paths[j].name, opp[0], len(opp) * self.paths[i].ds))
                if not any(x is not None for x in m):
                    continue
                self.map[i][j] = m
                self.shared_len[(i, j)] = sum(1 for x in m if x is not None) * self.paths[i].ds
                Pi, Pj = self.paths[i], self.paths[j]
                for k in range(Pi.n):
                    if m[k] is not None and m[k - 1] is None:
                        self.merges[i][j].append((k * Pi.ds, m[k]))
                    elif m[k] is None and m[k - 1] is not None:
                        self.diverges[i][j].append((k * Pi.ds, Pj.wrap(m[k - 1] + Pj.ds)))
        self.min_gap_seen = 1e9

    @staticmethod
    def _match(A, B, tol):
        """for every sample of A: s on B if B runs on the same rail in the same direction"""
        cell = max(2 * tol, 0.1)
        grid = {}
        for k, (x, y) in enumerate(B.xy):
            grid.setdefault((int(math.floor(x / cell)), int(math.floor(y / cell))), []).append(k)
        out, opp = [None] * A.n, []
        cos_lim = math.cos(math.radians(30))
        for k, (x, y) in enumerate(A.xy):
            cx, cy = int(math.floor(x / cell)), int(math.floor(y / cell))
            best = None
            for gx in (cx - 1, cx, cx + 1):
                for gy in (cy - 1, cy, cy + 1):
                    for kb in grid.get((gx, gy), ()):
                        bx, by = B.xy[kb]
                        d2 = (bx - x) ** 2 + (by - y) ** 2
                        if d2 <= tol * tol and (best is None or d2 < best[0]):
                            best = (d2, kb)
            if best is None:
                continue
            c = math.cos(A.yaw[k] - B.yaw[best[1]])
            if c >= cos_lim:
                out[k] = best[1] * B.ds
            elif c <= -cos_lim:
                opp.append((x, y))
        return out, opp

    def _on_path(self, i, j, o):
        """position of vehicle o (loop j) on loop i, or None if o is not on loop i's rail"""
        m = self.map[j][i]
        return None if m is None else m[self.paths[j].index(o.s)]

    def _merge_rule(self, i, v, j, o):
        """o (loop j) is on another branch. Does v (loop i) have to give way to
        it at a merge, or keep behind it right after a diverge?
        Returns (centre distance, leader speed) of the constraint, or None."""
        P, Pj, L = self.paths[i], self.paths[j], self.L
        stop_off = L / 2 + MERGE_CLEAR_M          # v's centre stops this far before the merge
        best = None
        for s_i, s_j in self.merges[i][j]:
            dv = P.ahead(v.s, s_i)
            do = Pj.ahead(o.s, s_j)
            if dv > self.look or do > MERGE_ZONE_M:
                continue
            o_first = do < dv or (abs(do - dv) < 1e-9 and o.idx < v.idx)
            v_comm = dv - stop_off < v.v * v.v / (2 * B_COMFORT) + 0.05
            o_comm = do - stop_off < o.v * o.v / (2 * B_COMFORT) + 0.05
            if v_comm and not o_comm:
                o_first = False
            elif o_comm and not v_comm:
                o_first = True
            if not o_first:
                continue
            if dv - do >= L + MIN_GAP_M:
                c = (dv - do, o.v)                    # zip in behind o
            else:
                c = (dv - stop_off + L + MIN_GAP_M, 0.0)   # wait at the stop line
            if best is None or c[0] < best[0]:
                best = c
        for s_i, s_j in self.diverges[i][j]:
            dv = P.ahead(v.s, s_i)
            past = Pj.ahead(s_j, o.s)
            if dv > self.look or past > L + MIN_GAP_M + MERGE_CLEAR_M:
                continue
            c = (dv + past, o.v)                      # o has not cleared the switch yet
            if best is None or c[0] < best[0]:
                best = c
        return best

    def leaders(self):
        allv = [(i, v) for i, s in enumerate(self.sims) for v in s.veh]
        out = {}
        for i, v in allv:
            P = self.paths[i]
            best = None
            for j, o in allv:
                if o is v:
                    continue
                if j == i:
                    c = (P.ahead(v.s, o.s), o.v)
                else:
                    so = self._on_path(i, j, o)
                    if so is not None:                 # o is on my rail
                        c = (P.ahead(v.s, so), o.v)
                        if c[0] > self.look:
                            continue
                    else:                              # o is on another branch
                        c = self._merge_rule(i, v, j, o)
                        if c is None:
                            continue
                if best is None or c[0] < best[0]:
                    best = (c[0], o, c[1])
            out[v.idx] = best
        return out

    def physical_min_gap(self):
        """smallest bumper gap between OHTs that really are on the same rail"""
        g = 1e9
        for i, s in enumerate(self.sims):
            for v in s.veh:
                for j, s2 in enumerate(self.sims):
                    for o in s2.veh:
                        if o is v:
                            continue
                        so = o.s if i == j else self._on_path(i, j, o)
                        if so is None:
                            continue
                        g = min(g, self.paths[i].ahead(v.s, so) - self.L)
        return g

    def place_initial(self):
        """spread the OHTs so nobody starts on top of an OHT of another loop"""
        need = self.L + MIN_GAP_M + 0.3
        placed = []                                     # (loop, s)

        def ok(i, s):
            P = self.paths[i]
            x, y, _ = P.rail_pose(s)
            for j, sj in placed:
                if j == i:
                    d = min(P.ahead(s, sj), P.ahead(sj, s))
                    if d < need:
                        return False
                    continue
                m = self.map[i][j]
                mine = m[P.index(s)] if m else None
                if mine is not None:                    # same rail: along-track distance
                    Pj = self.paths[j]
                    if min(Pj.ahead(mine, sj), Pj.ahead(sj, mine)) < need:
                        return False
                xj, yj, _ = self.paths[j].rail_pose(sj)
                if math.hypot(x - xj, y - yj) < self.L:  # different rail, but bodies too close
                    return False
            return True

        for i, sim in enumerate(self.sims):
            P, n = sim.path, len(sim.veh)
            if n == 0:
                continue
            spacing = P.length / n
            chosen = None
            for t in range(60):
                cand = [P.wrap(spacing * (k + t / 60.0)) for k in range(n)]
                if all(ok(i, c) for c in cand):
                    chosen = cand
                    break
            if chosen is None:                           # greedy fallback
                chosen, s = [], 0.0
                while s < P.length and len(chosen) < n:
                    if ok(i, s):
                        chosen.append(s)
                        placed.append((i, s))
                        s += need
                    else:
                        s += 0.05
                placed = [p for p in placed if p[0] != i]
                if len(chosen) < n:
                    raise ValueError("%s: no room to place %d OHTs without overlapping other loops"
                                     % (sim.name, n))
            for v, c in zip(sim.veh, chosen):
                v.s, v.v = c, 0.0
                placed.append((i, c))
            for v in sim.veh:
                v.target = None
            for v in sim.veh:
                sim._next_target(v)

    def step(self, dt):
        dt = min(dt, 0.25)
        n = max(1, int(math.ceil(dt / MAX_SUBSTEP_S)))
        h = dt / n
        for _ in range(n):
            leaders = self.leaders()
            for s in self.sims:
                s._substep(h, leaders)

    def summary(self):
        lines = []
        n = len(self.sims)
        for i in range(n):
            for j in range(i + 1, n):
                if (i, j) in self.shared_len:
                    lines.append("%s & %s share %.1f m of rail (%d merge point%s)"
                                 % (self.paths[i].name, self.paths[j].name, self.shared_len[(i, j)],
                                    len(self.merges[i][j]), "" if len(self.merges[i][j]) == 1 else "s"))
        return lines


