# ---------------------------------------------------------------------------
# Rail check: does a loop only use curves that exist?
# ---------------------------------------------------------------------------
def check_route_turns(name, corners):
    """Returns a list of problems. At the end of a bay lane the curve meets
    the vertical rail on the LANE_CURVE_SIDE of the lane, so at a corner that
    lies on a bay lane the vertical leg of the loop must go to that side."""
    problems = []
    n = len(corners)
    want = "north" if LANE_CURVE_SIDE > 0 else "south"
    for i in range(n):
        p0, c, p2 = corners[i - 1], corners[i], corners[(i + 1) % n]
        lane = next((y for y in BAY_LANES_Y if abs(c[1] - y) < 0.05), None)
        if lane is None:
            continue
        for other in (p0, p2):
            if abs(other[0] - c[0]) > 0.05 or abs(other[1] - c[1]) < 0.05:
                continue                      # not the vertical leg
            side = 1 if other[1] > c[1] else -1
            if side == LANE_CURVE_SIDE:
                continue
            v1 = (c[0] - p0[0], c[1] - p0[1])
            v2 = (p2[0] - c[0], p2[1] - c[1])
            turn = "LEFT" if v1[0] * v2[1] - v1[1] * v2[0] > 0 else "RIGHT"
            real = "RIGHT" if turn == "LEFT" else "LEFT"
            end = "west" if abs(c[0] - X_WEST) < abs(c[0] - X_EAST) else "east"
            problems.append(
                "%s: corner (%.3f, %.3f) turns %s between lane Y=%.3f and the %s vertical "
                "using a curve that bends %s - but the real curve at that lane end bends %s "
                "(for this direction it is a %s-turn curve)."
                % (name, c[0], c[1], turn, lane, end,
                   "south" if want == "north" else "north", want, real))
    return problems


