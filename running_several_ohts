# Route: bottom lane eastbound -> right rail north -> top lane westbound
#        -> left rail south.  The Magazine_Drop_Target is on the bottom lane.
ROUTE_XY = [
    (8.498, -24.141),
    (28.598, -24.141),
    (29.398, -23.341),
    (29.398, -21.041),
    (28.598, -20.241),
