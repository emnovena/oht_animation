# ---------------------------------------------------------------------------
# Route geometry (pure python, no USD needed)
# ---------------------------------------------------------------------------
class LoopPath:
    def __init__(self, corners, radius, step=0.05):
        pts = self._round_corners(corners, radius)
        pts.append(pts[0])
        # dense resample
        self.xy = []
        for (x0, y0), (x1, y1) in zip(pts[:-1], pts[1:]):
            seg = math.hypot(x1 - x0, y1 - y0)
            n = max(1, int(math.ceil(seg / step)))
            for k in range(n):
                t = k / n
                self.xy.append((x0 + (x1 - x0) * t, y0 + (y1 - y0) * t))
        self.s = [0.0]
        for i in range(1, len(self.xy) + 1):
            a, b = self.xy[i - 1], self.xy[i % len(self.xy)]
            self.s.append(self.s[-1] + math.hypot(b[0] - a[0], b[1] - a[1]))
        self.length = self.s[-1]
        self.n = len(self.xy)
        self.ds = self.length / self.n
        # heading and curvature-based speed limit per sample
        self.yaw = []
        for i in range(self.n):
            a, b = self.xy[i - 1], self.xy[(i + 1) % self.n]
            self.yaw.append(math.atan2(b[1] - a[1], b[0] - a[0]))
        # curvature averaged over +-0.5 m (the corners are made of short
        # straight pieces; without averaging the speed limit flickers)
        w = max(1, int(0.5 / self.ds))
        raw = []
        for i in range(self.n):
            d = self.yaw[(i + w) % self.n] - self.yaw[i - w]
            d = (d + math.pi) % (2 * math.pi) - math.pi
            k = abs(d) / (2 * w * self.ds)
            raw.append(V_MAX if k < 1e-3 else min(V_MAX, math.sqrt(V_CURVE_LAT_ACC / k)))
        # take the lowest limit of each corner for the whole corner
        self.vlim = [min(raw[(i + j) % self.n] for j in range(-w, w + 1)) for i in range(self.n)]
        # speed profile the OHT can actually follow: brake with B_COMFORT
        # before a corner, accelerate with A_MAX after it (loop: 2 passes)
        for _ in range(2):
            for i in range(self.n - 1, -1, -1):
                nxt = self.vlim[(i + 1) % self.n]
                self.vlim[i] = min(self.vlim[i], math.sqrt(nxt * nxt + 2 * B_COMFORT * self.ds))
            for i in range(self.n):
                prv = self.vlim[i - 1]
                self.vlim[i] = min(self.vlim[i], math.sqrt(prv * prv + 2 * A_MAX * self.ds))

    @staticmethod
    def _round_corners(c, r):
        out, n = [], len(c)
        for i in range(n):
            p0, p1, p2 = c[i - 1], c[i], c[(i + 1) % n]
            v1 = (p1[0] - p0[0], p1[1] - p0[1]); l1 = math.hypot(*v1)
            v2 = (p2[0] - p1[0], p2[1] - p1[1]); l2 = math.hypot(*v2)
            if l1 < 1e-6 or l2 < 1e-6:
                continue
            u1 = (v1[0] / l1, v1[1] / l1); u2 = (v2[0] / l2, v2[1] / l2)
            cosang = max(-1.0, min(1.0, u1[0] * u2[0] + u1[1] * u2[1]))
            theta = math.acos(cosang)
            if theta < math.radians(3):
                out.append(p1); continue
            t = min(r * math.tan(theta / 2), 0.45 * l1, 0.45 * l2)
            a = (p1[0] - u1[0] * t, p1[1] - u1[1] * t)
            b = (p1[0] + u2[0] * t, p1[1] + u2[1] * t)
            for k in range(9):          # quadratic bezier a -> p1 -> b
                q = k / 8
                out.append(((1-q)**2*a[0] + 2*(1-q)*q*p1[0] + q*q*b[0],
                            (1-q)**2*a[1] + 2*(1-q)*q*p1[1] + q*q*b[1]))
        return out

    def vlim_at(self, s):
        """curve speed limit, interpolated between samples (no steps)"""
        s = self.wrap(s)
        i = min(self.n - 1, int(s / self.ds))
        f = (s - i * self.ds) / self.ds
        a, b = self.vlim[i] ** 2, self.vlim[(i + 1) % self.n] ** 2
        return math.sqrt(a + (b - a) * f)

    def wrap(self, s):
        return s % self.length

    def index(self, s):
        return int(self.wrap(s) / self.ds) % self.n

    def pose(self, s):
        s = self.wrap(s)
        i = min(self.n - 1, int(s / self.ds))
        j = (i + 1) % self.n
        f = (s - i * self.ds) / self.ds
        x = self.xy[i][0] + (self.xy[j][0] - self.xy[i][0]) * f
        y = self.xy[i][1] + (self.xy[j][1] - self.xy[i][1]) * f
        return x, y, self.yaw[i]

    def project(self, xy):
        best, bi = 1e18, 0
        for i, p in enumerate(self.xy):
            d = (p[0] - xy[0]) ** 2 + (p[1] - xy[1]) ** 2
            if d < best:
                best, bi = d, i
        return bi * self.ds, math.sqrt(best)

    def ahead(self, s_from, s_to):
        """forward distance along the loop from s_from to s_to"""
        return (s_to - s_from) % self.length


# ---------------------------------------------------------------------------
# Traffic logic (pure python)
# ---------------------------------------------------------------------------
def _ease(t):
    """smooth start and stop (no jerk at the ends of hoist/claw moves)"""
    t = max(0.0, min(1.0, t))
    return t * t * (3 - 2 * t)


class Vehicle:
    def __init__(self, idx, s):
        self.idx = idx
        self.s = s
        self.v = 0.0
        self.state = "drive"      # drive | lower | grip | raise
        self.timer = 0.0
        self.hoist = 0.0          # 0 = up, 1 = fully lowered
        self.passes = {}         # station index -> times reached
        self.target = None        # (machine index, s) or None
        self.target_dist = 0.0
        self.mag = None           # magazine id being carried, or None
        self.action = None        # "pick" / "drop" while working at a machine
        self.claw = 0.0           # 0 = open, 1 = closed


class FleetSim:
    def __init__(self, path, n, veh_len, stations_s, machine_mag=None):
        self.path, self.L = path, veh_len
        self.stations_s = stations_s
        # machine index -> magazine id sitting on it (or None)
        self.machine_mag = list(machine_mag) if machine_mag else [None] * len(stations_s)
        need = n * (veh_len + MIN_GAP_M + 0.5)
        if need > path.length:
            raise ValueError("Loop is %.1f m but %d OHTs need %.1f m. Use fewer OHTs or a longer loop."
                             % (path.length, n, need))
        spacing = path.length / n
        self.veh = [Vehicle(i, i * spacing) for i in range(n)]
        self.min_gap_seen = 1e9
        self.on_event = None        # callback(vehicle, machine_index, "pick"/"drop", magazine_id)
        for v in self.veh:
            self._next_target(v)

    def gap_to_leader(self, v):
        best = None
        for o in self.veh:
            if o is v:
                continue
            d = self.path.ahead(v.s, o.s)
            if best is None or d < best[0]:
                best = (d, o)
        if best is None:                 # only one OHT
            return float("inf"), None
        return best[0] - self.L, best[1]

    def _next_target(self, v):
        """Empty OHT -> nearest machine with a magazine.
        Loaded OHT -> nearest empty machine. Machines another OHT is already
        heading to are skipped, so two OHTs never go for the same job."""
        v.target = None
        if not self.stations_s:
            return
        want_loaded = v.mag is None
        taken = {o.target[0] for o in self.veh if o is not v and o.target}
        best = None
        for k, ss in enumerate(self.stations_s):
            if k in taken or (self.machine_mag[k] is not None) != want_loaded:
                continue
            d = self.path.ahead(v.s, ss)
            if d < 0.05:            # the machine we are standing at
                continue
            if best is None or d < best[0]:
                best = (d, k, ss)
        if best:
            d, k, ss = best
            v.target, v.target_dist = (k, ss), d
        # no job available: v.target stays None and the OHT keeps circulating

    def step(self, dt):
        # catch up on slow frames with small substeps (max 0.25 s per frame)
        dt = min(dt, 0.25)
        n = max(1, int(math.ceil(dt / MAX_SUBSTEP_S)))
        for _ in range(n):
            self._substep(dt / n)

    def _substep(self, dt):
        old_s = {v.idx: v.s for v in self.veh}
        for v in self.veh:
            gap, lead = self.gap_to_leader(v)
            if v.state != "drive":
                self._station_work(v, dt)
                continue
            # 1) leader: braking curve + time headway
            free = gap - MIN_GAP_M
            if lead is None:
                v_lead_lim = V_MAX
            elif free <= 0:
                v_lead_lim = 0.0
            else:
                v_lead_lim = min(math.sqrt(lead.v ** 2 + 2 * B_COMFORT * free),
                                 lead.v + free / TIME_HEADWAY)
            # 2) curves: precomputed smooth speed profile
            v_curve = self.path.vlim_at(v.s + v.v * dt)
            if v.target is None:
                self._next_target(v)
            # 3) station stop
            v_stn = V_MAX
            if v.target:
                ds = max(0.0, v.target_dist)
                v_stn = math.sqrt(2 * B_COMFORT * max(0.0, ds - v.v * dt))
                if ds <= 1e-4:
                    k = v.target[0]
                    v.s, v.v, v.state, v.timer = v.target[1], 0.0, "lower", 0.0
                    if v.mag is None and self.machine_mag[k] is not None:
                        v.action = "pick"
                    elif v.mag is not None and self.machine_mag[k] is None:
                        v.action = "drop"
                    else:
                        v.action = None
                    continue
            v_target = min(V_MAX, v_lead_lim, v_curve, v_stn)
            if v_target >= v.v:
                v.v = min(v_target, v.v + A_MAX * dt)
            else:
                # follow the braking curve; it is built with B_COMFORT, so the
                # emergency limit is only reached if something cuts in suddenly
                v.v = max(v_target, v.v - B_EMERGENCY * dt)
            # hard safety clamp against the leader's previous position
            max_move = (self.path.ahead(v.s, old_s[lead.idx]) - self.L - MIN_GAP_M) if lead else 1e9
            move = min(v.v * dt, max(0.0, max_move))
            if v.target:                      # never roll past the stop point
                move = min(move, max(0.0, v.target_dist))
            if move < v.v * dt:
                v.v = move / dt
            v.s = self.path.wrap(v.s + move)
            if v.target:
                v.target_dist -= move
        # bookkeeping: smallest bumper gap observed
        for v in self.veh:
            g, _ = self.gap_to_leader(v)
            self.min_gap_seen = min(self.min_gap_seen, g)

    def _station_work(self, v, dt):
        v.timer += dt
        k = v.target[0]
        if v.state == "lower":
            v.hoist = _ease(v.timer / HOIST_TIME_S)
            if v.timer >= HOIST_TIME_S:
                v.state, v.timer, v.hoist = "grip", 0.0, 1.0
        elif v.state == "grip":
            f = _ease(v.timer / GRIP_TIME_S)
            if v.action == "pick":
                v.claw = f                 # close around the magazine
            elif v.action == "drop":
                v.claw = 1.0 - f           # open to release it
            if v.timer >= GRIP_TIME_S:
                if v.action == "pick":
                    v.mag, self.machine_mag[k] = self.machine_mag[k], None
                    if self.on_event:
                        self.on_event(v, k, "pick", v.mag)
                elif v.action == "drop":
                    mag, v.mag = v.mag, None
                    self.machine_mag[k] = mag
                    if self.on_event:
                        self.on_event(v, k, "drop", mag)
                v.state, v.timer = "raise", 0.0
        elif v.state == "raise":
            v.hoist = 1.0 - _ease(v.timer / HOIST_TIME_S)
            if v.timer >= HOIST_TIME_S:
                v.state, v.hoist, v.action = "drive", 0.0, None
                self._next_target(v)


