# Omniverse glue
# ---------------------------------------------------------------------------
def _run_in_omniverse():
    import omni.usd
    import omni.kit.app
    import omni.timeline
    from pxr import Usd, UsdGeom, UsdPhysics, Sdf, Gf, Vt

    old = getattr(builtins, "_oht_fleet", None)
    if old is not None:
        old.stop()

    stage = omni.usd.get_context().get_stage()
    tmpl = stage.GetPrimAtPath(TEMPLATE_PATH)
    if not tmpl.IsValid():
        raise RuntimeError("Template prim not found: " + TEMPLATE_PATH)

    # ---- route
    if ROUTE_PRIM:
        pts = stage.GetPrimAtPath(ROUTE_PRIM).GetAttribute("points").Get()
        corners = [(float(p[0]), float(p[1])) for p in pts]
    else:
        corners = list(ROUTE_XY)
    if REVERSE_DIRECTION:
        corners.reverse()
    path = LoopPath(corners, CORNER_RADIUS_M)

    # ---- template info
    t_attr = tmpl.GetAttribute("xformOp:translate:oht")
    oht_z = float(t_attr.Get()[2]) if t_attr and t_attr.Get() is not None else -0.199
    oht_z += OHT_Z_OFFSET_M
    base = tmpl.GetCustomDataByKey("ohtFollowerBaseOrient")
    base_q = Gf.Quatd(base[0], base[1], base[2], base[3]) if base is not None else Gf.Quatd(1, 0, 0, 0)

    veh_len = VEHICLE_LENGTH_M
    if veh_len is None:
        veh_len = 1.2
        try:
            cache = UsdGeom.BBoxCache(Usd.TimeCode.Default(), [UsdGeom.Tokens.default_, UsdGeom.Tokens.render])
            rng = cache.ComputeWorldBound(tmpl).ComputeAlignedRange()
            if not rng.IsEmpty():
                size = rng.GetSize()
                veh_len = max(0.6, min(2.0, max(size[0], size[1])))
        except Exception:
            pass

    drop_m = HOIST_DROP_M if HOIST_DROP_M is not None else 2.5

    # ---- fleet prims
    fleet = UsdGeom.Xform.Define(stage, FLEET_PATH).GetPrim()
    for child in list(fleet.GetChildren()):
        stage.RemovePrim(child.GetPath())

    src_layer = None
    for layer in stage.GetLayerStack():
        if layer.GetPrimAtPath(TEMPLATE_PATH):
            src_layer = layer
            break
    dst_layer = stage.GetEditTarget().GetLayer()

    prims = []
    for i in range(NUM_OHT):
        p = "%s/OHT_%02d" % (FLEET_PATH, i + 1)
        Sdf.CopySpec(src_layer, TEMPLATE_PATH, dst_layer, p)
        prim = stage.GetPrimAtPath(p)
        prim.ClearCustomDataByKey("ohtFollowerMagazine")
        UsdGeom.Imageable(prim).MakeVisible()
        hoist = stage.GetPrimAtPath(p + "/Hoist_Unit")
        hoist_attr = hoist.GetAttribute("xformOp:translate:hoistDrop") if hoist.IsValid() else None
        claws = []
        for name in ("Claw_Front", "Claw_Back"):
            cp = stage.GetPrimAtPath(p + "/Hoist_Unit/" + name)
            if cp.IsValid() and cp.GetAttribute("xformOp:translate").Get() is not None:
                a = cp.GetAttribute("xformOp:translate")
                claws.append((a, Gf.Vec3d(a.Get())))
        prims.append((prim.GetAttribute("xformOp:translate:oht"),
                      prim.GetAttribute("xformOp:orient:oht"),
                      hoist_attr, prim, claws))
    if HIDE_TEMPLATE:
        UsdGeom.Imageable(tmpl).MakeInvisible()

    # hoist: convert world metres to the model's local units
    # (the template uses xformOp:scale:oht = 0.01, so 1 m = 100 local units)
    hoist_scale = 1.0
    sc = prims[0][3].GetAttribute("xformOp:scale:oht")
    if sc and sc.Get() is not None and abs(sc.Get()[2]) > 1e-9:
        hoist_scale = abs(sc.Get()[2])
    drop_local = drop_m / hoist_scale

    if SHOW_ROUTE:
        c = UsdGeom.BasisCurves.Define(stage, FLEET_PATH + "/Route_Debug")
        pts = [Gf.Vec3f(x, y, 0.065) for x, y in path.xy] + [Gf.Vec3f(path.xy[0][0], path.xy[0][1], 0.065)]
        c.CreatePointsAttr(Vt.Vec3fArray(pts))
        c.CreateCurveVertexCountsAttr([len(pts)])
        c.CreateTypeAttr("linear")
        c.CreateWidthsAttr([0.03])
        c.CreateDisplayColorAttr([Gf.Vec3f(0.1, 0.8, 0.2)])

    # ---- ground machines -> stations
    def _yaw_of(prim):
        o = prim.GetAttribute("xformOp:orient")
        if o and o.Get() is not None:
            q = o.Get()
            return 2 * math.atan2(q.GetImaginary()[2], q.GetReal())
        return 0.0

    def _port_of(prim):
        t = prim.GetAttribute("xformOp:translate").Get()
        yaw = _yaw_of(prim)
        ox, oy, oz = PORT_OFFSET_LOCAL
        c, s_ = math.cos(yaw), math.sin(yaw)
        return (t[0] + c * ox - s_ * oy, t[1] + s_ * ox + c * oy, t[2] + oz)

    def _footprint(prim):
        try:
            cache = UsdGeom.BBoxCache(Usd.TimeCode.Default(), [UsdGeom.Tokens.default_, UsdGeom.Tokens.render])
            r = cache.ComputeWorldBound(prim).ComputeAlignedRange()
            if r.IsEmpty():
                return None
            return (r.GetMin()[0], r.GetMin()[1], r.GetMax()[0], r.GetMax()[1])
        except Exception:
            return None

    def _overlap(a, b, margin=0.05):
        return not (a[2] + margin <= b[0] or b[2] + margin <= a[0] or
                    a[3] + margin <= b[1] or b[3] + margin <= a[1])

    machines = [stage.GetPrimAtPath(p) for p in EXISTING_GROUND_MACHINES]
    machines = [m for m in machines if m.IsValid()]
    gm_tmpl = stage.GetPrimAtPath(GROUND_MACHINE_TEMPLATE)
    gm_root = stage.GetPrimAtPath(GROUND_MACHINES_PATH)
    if gm_root.IsValid():
        stage.RemovePrim(gm_root.GetPath())
    if gm_tmpl.IsValid() and NEW_MACHINE_PORTS:
        UsdGeom.Xform.Define(stage, GROUND_MACHINES_PATH)
        gm_layer = None
        for layer in stage.GetLayerStack():
            if layer.GetPrimAtPath(GROUND_MACHINE_TEMPLATE):
                gm_layer = layer
                break
        t0 = gm_tmpl.GetAttribute("xformOp:translate").Get()
        yaw0 = _yaw_of(gm_tmpl)
        fp0 = _footprint(gm_tmpl)
        if fp0 is None and SKIP_OVERLAPPING_MACHINES:
            print("[OHT Fleet] could not measure the ground machine size (payload not loaded?) — overlap check skipped")
        boxes = [b for b in (_footprint(m) for m in machines) if b]
        ox, oy, _ = PORT_OFFSET_LOCAL
        c, s_ = math.cos(yaw0), math.sin(yaw0)
        for n_i, (px, py) in enumerate(NEW_MACHINE_PORTS):
            mx, my = px - (c * ox - s_ * oy), py - (s_ * ox + c * oy)
            if fp0 is not None and SKIP_OVERLAPPING_MACHINES:
                dx, dy = mx - t0[0], my - t0[1]
                box = (fp0[0] + dx, fp0[1] + dy, fp0[2] + dx, fp0[3] + dy)
                if any(_overlap(box, b) for b in boxes):
                    print("[OHT Fleet] skipped machine at port (%.2f, %.2f): would overlap another machine" % (px, py))
                    continue
                boxes.append(box)
            p = "%s/GM_%02d" % (GROUND_MACHINES_PATH, n_i + 3)
            Sdf.CopySpec(gm_layer, GROUND_MACHINE_TEMPLATE, dst_layer, p)
            gm = stage.GetPrimAtPath(p)
            gm.GetAttribute("xformOp:translate").Set(Gf.Vec3d(mx, my, t0[2]))
            machines.append(gm)

    stations_s, station_names, slots = [], [], []
    for m in machines:
        port = _port_of(m)
        s, off = path.project(port[:2])
        if off > 0.5:
            print("[OHT Fleet] %s is %.2f m away from the OHT route — not used as a stop" % (m.GetName(), off))
            continue
        stations_s.append(s)
        station_names.append(m.GetName())
        x, y, _ = path.pose(s)            # magazine sits right under the OHT stop
        slots.append((x, y, port[2], _yaw_of(m)))
    print("[OHT Fleet] %d ground machines used as stops: %s" % (len(stations_s), ", ".join(station_names)))

    # ---- magazines
    mag_root = stage.GetPrimAtPath(MAGAZINES_PATH)
    if mag_root.IsValid():
        stage.RemovePrim(mag_root.GetPath())
    mag_tmpl = stage.GetPrimAtPath(MAGAZINE_TEMPLATE)
    n_mag = NUM_MAGAZINES if NUM_MAGAZINES is not None else len(stations_s) // 2
    n_mag = max(0, min(n_mag, len(stations_s) - 1))
    machine_mag = [None] * len(stations_s)
    mags = []          # per magazine: dict(t=translate attr, o=orient attr, pose=(x,y,z,yaw))
    if mag_tmpl.IsValid() and n_mag > 0:
        UsdGeom.Xform.Define(stage, MAGAZINES_PATH)
        mag_layer = next((l for l in stage.GetLayerStack() if l.GetPrimAtPath(MAGAZINE_TEMPLATE)), None)
        # spread magazines over the machines: 0, 2, 4, ...
        order = list(range(0, len(stations_s), 2)) + list(range(1, len(stations_s), 2))
        for m_i in range(n_mag):
            k = order[m_i]
            p = "%s/MAG_%02d" % (MAGAZINES_PATH, m_i + 1)
            Sdf.CopySpec(mag_layer, MAGAZINE_TEMPLATE, dst_layer, p)
            mp = stage.GetPrimAtPath(p)
            mp.ClearCustomData()
            UsdGeom.Imageable(mp).MakeVisible()
            if MAGAZINE_INSTANCEABLE:
                mp.SetInstanceable(True)
            # drop the old carry op, place directly in world space
            mp.GetAttribute("xformOpOrder").Set(
                Vt.TokenArray(["xformOp:translate", "xformOp:orient", "xformOp:scale"]))
            if mp.HasAttribute("xformOp:transform:carry"):
                mp.RemoveProperty("xformOp:transform:carry")
            o_attr = mp.GetAttribute("xformOp:orient")
            mags.append({"t": mp.GetAttribute("xformOp:translate"), "o": o_attr,
                         "quatf": str(o_attr.GetTypeName()) == "quatf",
                         "pose": slots[k], "attach": None})
            machine_mag[k] = m_i
        if HIDE_ORIGINAL_MAGAZINE:
            UsdGeom.Imageable(mag_tmpl).MakeInvisible()
        print("[OHT Fleet] %d magazines placed on: %s"
              % (n_mag, ", ".join(station_names[k] for k in range(len(stations_s)) if machine_mag[k] is not None)))
    elif n_mag > 0:
        print("[OHT Fleet] magazine template %s not found — OHTs will only move the hoist" % MAGAZINE_TEMPLATE)

    def _set_mag_pose(m, x, y, z, yaw):
        m["t"].Set(Gf.Vec3d(x, y, z))
        h = yaw / 2
        if m["quatf"]:
            m["o"].Set(Gf.Quatf(math.cos(h), 0, 0, math.sin(h)))
        else:
            m["o"].Set(Gf.Quatd(math.cos(h), 0, 0, math.sin(h)))

    for m in mags:
        _set_mag_pose(m, *m["pose"])

    def _gripper(v):
        x, y, yaw = path.pose(v.s)
        return x, y, oht_z - drop_m * v.hoist, yaw

    def on_event(v, k, kind, mag_id):
        if mag_id is None or mag_id >= len(mags):
            return
        m = mags[mag_id]
        gx, gy, gz, gyaw = _gripper(v)
        if kind == "pick":
            # rigid attach: remember where the magazine is relative to the gripper
            mx, my, mz, myaw = m["pose"]
            dx, dy = mx - gx, my - gy
            c, s_ = math.cos(-gyaw), math.sin(-gyaw)
            m["attach"] = (c * dx - s_ * dy, s_ * dx + c * dy, mz - gz, myaw - gyaw)
        else:
            m["attach"] = None    # released: it stays where it was set down
        if LOG_JOBS:
            print("[OHT Fleet] OHT_%02d %s MAG_%02d at %s"
                  % (v.idx + 1, "picked up" if kind == "pick" else "dropped off", mag_id + 1, station_names[k]))

    # ---- auto hoist length: claw tips (hoist up) -> top of a magazine on a machine
    if HOIST_DROP_M is None and mags:
        try:
            cache = UsdGeom.BBoxCache(Usd.TimeCode.Default(), [UsdGeom.Tokens.default_, UsdGeom.Tokens.render])
            hu = stage.GetPrimAtPath(FLEET_PATH + "/OHT_01/Hoist_Unit")
            first_mag = stage.GetPrimAtPath(MAGAZINES_PATH + "/MAG_01")
            prims[0][0].Set(Gf.Vec3d(0, 0, oht_z))          # hoist fully up
            if hu.IsValid():
                prims[0][2] and prims[0][2].Set(Gf.Vec3d(0, 0, 0))
            claw_bottom = cache.ComputeWorldBound(hu).ComputeAlignedRange()
            mag_box = cache.ComputeWorldBound(first_mag).ComputeAlignedRange()
            if not claw_bottom.IsEmpty() and not mag_box.IsEmpty():
                d = claw_bottom.GetMin()[2] - (mag_box.GetMax()[2] - GRIP_DEPTH_M)
                if 0.1 < d < 10:
                    drop_m = d
                    print("[OHT Fleet] hoist length measured: %.2f m (claw tips to magazine top)" % d)
                else:
                    print("[OHT Fleet] hoist auto-measure gave %.2f m — using %.2f m; set HOIST_DROP_M" % (d, drop_m))
            else:
                print("[OHT Fleet] could not measure hoist/magazine (payload not loaded?) — using %.2f m" % drop_m)
        except Exception as ex:
            print("[OHT Fleet] hoist auto-measure failed (%s) — using %.2f m" % (ex, drop_m))
    drop_local = drop_m / hoist_scale

    sim = FleetSim(path, NUM_OHT, veh_len, stations_s, machine_mag)
    sim.on_event = on_event
    timeline = omni.timeline.get_timeline_interface()
    yaw_off = math.radians(YAW_OFFSET_DEG)

    # ---- hoist cables: attach points in the OHT's own frame
    def _qyaw(q):
        return 2 * math.atan2(q.GetImaginary()[2], q.GetReal())
    base_yaw = _qyaw(base_q)
    cable_pts_local = None          # list of (dx, dy, dz_top) in model frame
    ct = stage.GetPrimAtPath(CABLE_TEMPLATE)
    t_pos = tmpl.GetAttribute("xformOp:translate:oht").Get()
    t_ori = tmpl.GetAttribute("xformOp:orient:oht").Get()
    if ct.IsValid() and ct.GetAttribute("points").Get() and t_pos is not None and t_ori is not None:
        pts = ct.GetAttribute("points").Get()
        th = -_qyaw(t_ori)
        c_, s2 = math.cos(th), math.sin(th)
        cable_pts_local = []
        for i in range(0, len(pts) - 1, 2):
            top = max(pts[i], pts[i + 1], key=lambda p: p[2])
            dx, dy = top[0] - t_pos[0], top[1] - t_pos[1]
            cable_pts_local.append((c_ * dx - s2 * dy, s2 * dx + c_ * dy, top[2] - t_pos[2]))
    if cable_pts_local is None:      # fallback: 4 cables around the hoist centre
        cable_pts_local = [(sx * 0.1, sy * 0.05, -0.096) for sx in (-1, 1) for sy in (-1, 1)]
    # Each cable is a thin cylinder (renders reliably in RTX, unlike curves):
    # 1 m tall, stretched with its Z scale to the current hoist depth.
    cable_ops = []                 # per OHT: list of (translate op, scale op)
    if SHOW_CABLES:
        UsdGeom.Scope.Define(stage, FLEET_PATH + "/Hoist_Cables")
        for i in range(NUM_OHT):
            ops = []
            for j in range(len(cable_pts_local)):
                cyl = UsdGeom.Cylinder.Define(stage, "%s/Hoist_Cables/OHT_%02d_%d" % (FLEET_PATH, i + 1, j))
                cyl.CreateRadiusAttr(CABLE_WIDTH_M / 2)
                cyl.CreateHeightAttr(1.0)
                cyl.CreateAxisAttr(UsdGeom.Tokens.z)
                cyl.CreateDisplayColorAttr([Gf.Vec3f(*CABLE_COLOR)])
                ops.append((cyl.AddTranslateOp(), cyl.AddScaleOp()))
            cable_ops.append(ops)

    def _update_cables():
        for v, ops in zip(sim.veh, cable_ops):
            x, y, yaw = path.pose(v.s)
            th = yaw + yaw_off + base_yaw          # model yaw of this OHT
            c_, s2 = math.cos(th), math.sin(th)
            length = max(1e-4, drop_m * v.hoist + 0.002)
            for (dx, dy, dz), (t_op, s_op) in zip(cable_pts_local, ops):
                top = oht_z + dz
                t_op.Set(Gf.Vec3d(x + c_ * dx - s2 * dy, y + s2 * dx + c_ * dy, top - length / 2))
                s_op.Set(Gf.Vec3f(1, 1, length))

    def write_poses():
        with Sdf.ChangeBlock():
            for v, (t_a, o_a, h_a, _, claws) in zip(sim.veh, prims):
                x, y, yaw = path.pose(v.s)
                t_a.Set(Gf.Vec3d(x, y, oht_z))
                half = (yaw + yaw_off) / 2
                q = Gf.Quatd(math.cos(half), 0, 0, math.sin(half)) * base_q
                o_a.Set(q)
                if h_a:
                    h_a.Set(Gf.Vec3d(0, 0, -drop_local * v.hoist))
                for c_attr, rest in claws:      # move each claw toward the centre
                    inward = -1.0 if rest[0] > 0 else 1.0
                    c_attr.Set(Gf.Vec3d(rest[0] + inward * CLAW_CLOSE_M * v.claw, rest[1], rest[2]))
                if v.mag is not None and v.mag < len(mags) and mags[v.mag]["attach"]:
                    m = mags[v.mag]
                    ax, ay, az, ayaw = m["attach"]
                    gx, gy, gz, gyaw = _gripper(v)
                    c, s_ = math.cos(gyaw), math.sin(gyaw)
                    # Gradually pull the magazine upward as the hoist rises
                    stow_z = CARRY_RAISE_M * (1.0 - v.hoist)

                    m["pose"] = (
                        gx + c * ax - s_ * ay,
                        gy + s_ * ax + c * ay,
                        gz + az + stow_z,
                        gyaw + ayaw
                    )
                    _set_mag_pose(m, *m["pose"])
            _update_cables()

    write_poses()

    # Kinematic physics: if the OHT model has rigid bodies, physics would
    # overwrite our positions every frame and the OHTs would not move.
    n_kin = 0
    for _, _, _, prim, _ in prims:
        for p in Usd.PrimRange(prim):
            if p.HasAPI(UsdPhysics.RigidBodyAPI):
                UsdPhysics.RigidBodyAPI(p).CreateKinematicEnabledAttr(True)
                n_kin += 1
    if n_kin:
        print("[OHT Fleet] set %d rigid bodies to kinematic" % n_kin)

    import time
    import traceback

    class _Handle:
        def __init__(self):
            self.sim = sim
            self.last = None
            self.errors = 0
            self.frames = 0
            self.sub = None
            self.observer = None
            try:   # Kit 105/106 (Isaac Sim 4.x)
                self.sub = omni.kit.app.get_app().get_update_event_stream().create_subscription_to_pop(
                    self._on_update, name="oht_fleet_controller")
            except Exception:   # newer Kit (Isaac Sim 5.x)
                import carb.eventdispatcher
                self.observer = carb.eventdispatcher.get_eventdispatcher().observe_event(
                    event_name=omni.kit.app.GLOBAL_EVENT_UPDATE,
                    on_event=self._on_update, observer_name="oht_fleet_controller")

        def _on_update(self, *_):
            now = time.perf_counter()
            dt = 0.0 if self.last is None else now - self.last
            self.last = now
            if RUN_ONLY_WHEN_PLAYING and not timeline.is_playing():
                return
            try:
                self.sim.step(dt)
                write_poses()
                self.frames += 1
                if self.frames == 30:
                    v = self.sim.veh[0]
                    print("[OHT Fleet] running — OHT_01 speed %.2f m/s, state %s" % (v.v, v.state))
            except Exception:
                self.errors += 1
                if self.errors <= 3:
                    print("[OHT Fleet] ERROR in update:\n" + traceback.format_exc())

        def stop(self):
            if self.sub:
                self.sub.unsubscribe()
                self.sub = None
            self.observer = None
            print("[OHT Fleet] stopped")

    builtins._oht_fleet = _Handle()
    print("[OHT Fleet] %d OHTs on a %.1f m loop, vehicle length %.2f m, hoist drop %.2f m, OHT z %.3f.%s"
          % (NUM_OHT, path.length, veh_len, drop_m, oht_z,
             " Press PLAY." if RUN_ONLY_WHEN_PLAYING else " Moving now."))


try:
    import omni.usd  # noqa: F401
    _run_in_omniverse()
except ImportError:
    pass   # imported outside Omniverse (e.g. for offline testing)
